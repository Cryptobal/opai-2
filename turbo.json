{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.base.mjs", "prettier.config.mjs"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "DEV_TENANT_ID", "NODE_ENV", "VERCEL_GIT_COMMIT_SHA"]
    },
    "generate": { "outputs": ["src/generated/**"] },
    "typecheck": { "dependsOn": ["^typecheck", "generate"] },
    "lint": { "dependsOn": ["generate"] }
  }
}
