# Copia este archivo a .env.local (ignorado por git). Nunca commitees valores reales.

# Aplicación (rol opai_app, sin BYPASSRLS, conexión pooled). La app solo usa esta URL.
DATABASE_URL=

# Pool pg por instancia (en Vercel se avisa si el host no contiene -pooler.).
DATABASE_POOL_MAX=4
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# Transacciones de Prisma (opcional; defectos entre paréntesis). Las comparten forTenant, forUser,
# enTransaccion, las lecturas en una sola transacción (enLectura, ADR-045) y Better Auth, porque
# todas pasan por el mismo cliente del pool.
#  - DATABASE_TX_MAX_WAIT_MS (10000): cuánto espera Prisma una conexión del pool antes de lanzar
#    P2028 ("Unable to start a transaction in the given time"). El defecto de Prisma (2 s) se cortaba
#    bajo ráfaga antes de que la cola del pool entregara la conexión; se alinea con
#    DATABASE_POOL_CONNECTION_TIMEOUT_MS para que mande el plazo real del pool (B1, #134/#135).
#    Recomendado: igual a DATABASE_POOL_CONNECTION_TIMEOUT_MS (10000).
#  - DATABASE_TX_TIMEOUT_MS (15000): cuánto puede durar una transacción abierta antes de que Prisma
#    la expire ("A commit cannot be executed on an expired transaction"). Mayor que maxWait para que
#    una transacción que esperó conexión aún tenga tiempo de completar. Recomendado: 15000.
DATABASE_TX_MAX_WAIT_MS=10000
DATABASE_TX_TIMEOUT_MS=15000

# Migraciones (rol propietario, conexión directa). Solo en la máquina de Carlos o en CI; nunca en Vercel.
DATABASE_URL_MIGRATE=

# Tests de base de datos (rama dev de Neon o Postgres local). Si no existe, test:db se omite.
DATABASE_URL_TEST=

# Contraseña que la migración inicial asigna al rol opai_app (se genera con: openssl rand -base64 32)
OPAI_APP_DB_PASSWORD=

# Captura diaria UF/UTM del SII: rol `opai_cron_sii` (único con EXECUTE en remuneraciones_publicar_sii).
# En Vercel (production y preview): DATABASE_URL_CRON_SII con la URL pooled de opai_cron_sii; contraseña
# con `pnpm --filter @opai/db role:cron-sii-password` y OPAI_CRON_SII_DB_PASSWORD (nunca en el repo).
DATABASE_URL_CRON_SII=
OPAI_CRON_SII_DB_PASSWORD=

# Better Auth (Brief 01). Secreto: openssl rand -base64 32. URL pública de la app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Correo transaccional (Resend). Sin RESEND_API_KEY los correos se escriben en el log del servidor.
RESEND_API_KEY=
EMAIL_FROM="OPAI <no-reply@opai.cl>"

# Google (opcional). Sin ambas, el login no muestra "Continuar con Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed del usuario plataforma (pnpm --filter @opai/auth seed:platform-owner) y Playwright (acceso.spec).
SEED_OWNER_PASSWORD=

# Brief 02 · servicios del núcleo
# Crons de Vercel (/api/cron/*): Vercel envía "Authorization: Bearer <CRON_SECRET>". Sin él, 503.
CRON_SECRET=
# KEK del almacén de secretos por tenant (openssl rand -base64 32) y su versión. Al rotar:
# la nueva va en OPAI_SECRETS_KEY (versión +1) y la vigente en OPAI_SECRETS_KEY_ANTERIOR mientras
# corre `pnpm --filter @opai/capabilities rotar-kek`.
OPAI_SECRETS_KEY=
OPAI_SECRETS_KEY_VERSION=1
OPAI_SECRETS_KEY_ANTERIOR=

# App de Slack «OPAI» (ADR-093, CAR-290). Las saca Carlos de api.slack.com (Basic Information) y las
# carga en Vercel; nunca en el repositorio. Sin ellas, «Conectar con Slack» no aparece y OPAI funciona igual.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Brief 14 · Rondas PR 2. Obligatoria: sin ella (o con menos de 32 bytes) no se generan ni verifican
# etiquetas QR (falla cerrado). La carga Carlos en Vercel (preview y prod); nunca un valor fijo en el
# código ni respaldo a BETTER_AUTH_SECRET (openssl rand -base64 32).
RONDAS_ETIQUETA_SECRET=

# Cloudflare R2 (documentos; bucket privado, token con permiso solo a ese bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Credenciales de plataforma (modalidad "de plataforma"; los tenants pueden usar las propias).
GOOGLE_MAPS_SERVER_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
