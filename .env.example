# Copia este archivo a .env.local (ignorado por git). Nunca commitees valores reales.

# Aplicación (rol opai_app, sin BYPASSRLS, conexión pooled). La app solo usa esta URL.
DATABASE_URL=

# Pool pg por instancia (en Vercel DATABASE_URL debe usar el endpoint -pooler de Neon).
DATABASE_POOL_MAX=4
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# Migraciones (rol propietario, conexión directa). Solo en la máquina de Carlos o en CI; nunca en Vercel.
DATABASE_URL_MIGRATE=

# Tests de base de datos (rama dev de Neon o Postgres local). Si no existe, test:db se omite.
DATABASE_URL_TEST=

# Contraseña que la migración inicial asigna al rol opai_app (se genera con: openssl rand -base64 32)
OPAI_APP_DB_PASSWORD=

# Better Auth (Brief 01). Secreto: openssl rand -base64 32. URL pública de la app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Correo transaccional (Resend). Sin RESEND_API_KEY los correos se escriben en el log del servidor.
RESEND_API_KEY=
EMAIL_FROM="OPAI <no-reply@opai.cl>"

# Google (opcional). Sin ambas, el login no muestra "Continuar con Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed del usuario plataforma (pnpm --filter @opai/auth seed:platform-owner) y Playwright (acceso.spec).
SEED_OWNER_PASSWORD=

# Brief 02 · servicios del núcleo
# Crons de Vercel (/api/cron/*): Vercel envía "Authorization: Bearer <CRON_SECRET>". Sin él, 503.
CRON_SECRET=
# KEK del almacén de secretos por tenant (openssl rand -base64 32) y su versión. Al rotar:
# la nueva va en OPAI_SECRETS_KEY (versión +1) y la vigente en OPAI_SECRETS_KEY_ANTERIOR mientras
# corre `pnpm --filter @opai/capabilities rotar-kek`.
OPAI_SECRETS_KEY=
OPAI_SECRETS_KEY_VERSION=1
OPAI_SECRETS_KEY_ANTERIOR=
# Cloudflare R2 (documentos; bucket privado, token con permiso solo a ese bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Credenciales de plataforma (modalidad "de plataforma"; los tenants pueden usar las propias).
GOOGLE_MAPS_SERVER_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
