# Copia este archivo a .env.local (ignorado por git). Nunca commitees valores reales.

# Aplicación (rol opai_app, sin BYPASSRLS, conexión pooled). La app solo usa esta URL.
DATABASE_URL=

# Migraciones (rol propietario, conexión directa). Solo en la máquina de Carlos o en CI; nunca en Vercel.
DATABASE_URL_MIGRATE=

# Tests de base de datos (rama dev de Neon o Postgres local). Si no existe, test:db se omite.
DATABASE_URL_TEST=

# Contraseña que la migración inicial asigna al rol opai_app (se genera con: openssl rand -base64 32)
OPAI_APP_DB_PASSWORD=

# Better Auth (Brief 01). Secreto: openssl rand -base64 32. URL pública de la app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Correo transaccional (Resend). Sin RESEND_API_KEY los correos se escriben en el log del servidor.
RESEND_API_KEY=
EMAIL_FROM="OPAI <no-reply@opai.cl>"

# Google (opcional). Sin ambas, el login no muestra "Continuar con Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed del usuario plataforma (pnpm --filter @opai/auth seed:platform-owner) y Playwright (acceso.spec).
SEED_OWNER_PASSWORD=
