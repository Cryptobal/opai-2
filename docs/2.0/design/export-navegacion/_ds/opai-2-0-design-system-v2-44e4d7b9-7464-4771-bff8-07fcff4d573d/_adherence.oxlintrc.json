{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/patterns/**",
              "components/previews/**",
              "components/shell/**",
              "ui_kits/opai/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Inter Variable|JetBrains Mono|JetBrains Mono Variable))/i]",
        "message": "Font not provided by the design system. Available: Inter, Inter Variable, JetBrains Mono, JetBrains Mono Variable."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:summary|children|style|key|ref|className|style|children)$/]",
        "message": "<ActionBar> doesn't accept that prop. Declared props: summary, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|count|children|padding|height|leading|key|ref|className|style|children)$/]",
        "message": "<AppBar> doesn't accept that prop. Declared props: title, subtitle, count, children, padding, height, leading."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:device|theme|width|height|portal|tenant|tenantInitials|user|tabs|railFooter|groups|active|onNavigate|onPortal|onSearch|onNotifications|notifications|offline|title|count|subtitle|headerActions|appBar|topBar|hideTopBar|hideTabBar|safeTop|children|overlay|style|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: device, theme, width, height, portal, tenant, tenantInitials, user, tabs, railFooter, groups, active, onNavigate, onPortal, onSearch, onNotifications, notifications, offline, title, count, subtitle, headerActions, appBar, topBar, hideTopBar, hideTabBar, safeTop, children, overlay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='device'] > Literal[value!=/^(?:phone|tablet|desktop)$/]",
        "message": "<AppShell> device must be one of 'phone' | 'tablet' | 'desktop'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<AppShell> theme must be one of 'light' | 'dark'."
