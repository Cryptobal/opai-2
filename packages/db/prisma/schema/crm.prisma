// Núcleo — contacto en varias cuentas, actividad unificada y etiquetas (CRM PR 2a, CAR-26,
// ADR-040 §5). Schema `core`. Toda tabla con tenant_id, RLS `tenant_isolation` (FORCE), IDs uuid(7) y
// columnas snake_case por @map. Como en Comercial, el tenant_id NO lleva @relation a Tenant: la FK a
// core.tenants va en el SQL, igual que los triggers de mismo tenant.

/// Vínculo contacto–cuenta (N–N). `core.contactos.cuenta_id` se conserva como vínculo inicial: un
/// trigger crea el vínculo al insertar el contacto y lo mantiene al editar cargo, roles o principal.
model ContactoCuenta {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  contactoId  String   @map("contacto_id") @db.Uuid
  cuentaId    String   @map("cuenta_id") @db.Uuid
  /// Cargo de la persona en esa cuenta.
  cargo       String?
  /// "comercial" | "operacional" | "facturacion" | "cobranza" | "cesion"
  roles       String[] @default([])
  /// Un solo principal por cuenta (índice parcial único).
  esPrincipal Boolean  @default(false) @map("es_principal")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contacto Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  cuenta   Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactoId, cuentaId])
  @@index([tenantId, cuentaId])
  @@map("contacto_cuentas")
  @@schema("core")
}

/// Nota, llamada, correo, WhatsApp, reunión, visita o tarea. Se liga a negocio, cuenta, contacto e
/// instalación por `actividad_vinculos`. Las tareas llevan prioridad, estado y responsables.
model Actividad {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// "nota" | "llamada" | "correo" | "whatsapp" | "reunion" | "visita" | "tarea"
  tipo            String
  titulo          String
  detalle         String?
  /// Cuándo ocurrió (puede ser pasada); distinto de created_at.
  ocurrioEn       DateTime  @default(now()) @map("ocurrio_en") @db.Timestamptz(6)
  /// Solo tareas.
  vencimiento     DateTime? @db.Timestamptz(6)
  todoElDia       Boolean   @default(false) @map("todo_el_dia")
  /// "alta" | "media" | "baja". Solo tareas.
  prioridad       String?
  /// "pendiente" | "hecha" | "cancelada". Solo tareas.
  estado          String?
  /// Reuniones: asistentes (texto libre), acuerdos y próximo paso.
  asistentes      String[]  @default([])
  acuerdos        String?
  proximoPaso     String?   @map("proximo_paso")
  completadaEn    DateTime? @map("completada_en") @db.Timestamptz(6)
  completadaPorId String?   @map("completada_por_id") @db.Uuid
  creadaPorId     String?   @map("creada_por_id") @db.Uuid
  /// Llamadas y correos registrados: "contesto" | "no_contesto" | "volver_a_llamar".
  resultado       String?
  /// Solo tareas: cuándo se emitió el aviso de tarea vencida (una vez por vencimiento; posponer lo limpia).
  avisoVencidaEn  DateTime? @map("aviso_vencida_en") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  vinculos     ActividadVinculo[]
  responsables ActividadResponsable[]

  @@index([tenantId, tipo, estado, vencimiento])
  @@index([tenantId, ocurrioEn])
  @@map("actividades")
  @@schema("core")
}

/// A qué entidad se liga una actividad: exactamente una de las cuatro columnas (CHECK).
model ActividadVinculo {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actividadId   String   @map("actividad_id") @db.Uuid
  negocioId     String?  @map("negocio_id") @db.Uuid
  cuentaId      String?  @map("cuenta_id") @db.Uuid
  contactoId    String?  @map("contacto_id") @db.Uuid
  instalacionId String?  @map("instalacion_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actividad   Actividad    @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  negocio     Negocio?     @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cuenta      Cuenta?      @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  contacto    Contacto?    @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  instalacion Instalacion? @relation(fields: [instalacionId], references: [id], onDelete: Cascade)

  @@index([tenantId, actividadId])
  @@index([tenantId, negocioId])
  @@index([tenantId, cuentaId])
  @@index([tenantId, contactoId])
  @@index([tenantId, instalacionId])
  @@map("actividad_vinculos")
  @@schema("core")
}

/// Responsables de una tarea (al menos uno lo exige la capacidad). Usuarios miembros de la empresa.
model ActividadResponsable {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actividadId String   @map("actividad_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actividad Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  @@unique([tenantId, actividadId, usuarioId])
  @@index([tenantId, usuarioId])
  @@map("actividad_responsables")
  @@schema("core")
}

/// Catálogo de etiquetas del tenant.
model Etiqueta {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nombre    String
  /// Tono del DS: "neutral" | "info" | "success" | "warning" | "danger".
  tono      String   @default("neutral")
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  asignaciones EtiquetaAsignacion[]

  @@unique([tenantId, nombre])
  @@map("etiquetas")
  @@schema("core")
}

/// Etiqueta asignada a un negocio, una cuenta o un contacto: exactamente una columna (CHECK).
model EtiquetaAsignacion {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  etiquetaId String   @map("etiqueta_id") @db.Uuid
  negocioId  String?  @map("negocio_id") @db.Uuid
  cuentaId   String?  @map("cuenta_id") @db.Uuid
  contactoId String?  @map("contacto_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  etiqueta Etiqueta  @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  negocio  Negocio?  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cuenta   Cuenta?   @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  contacto Contacto? @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@index([tenantId, etiquetaId])
  @@index([tenantId, negocioId])
  @@index([tenantId, cuentaId])
  @@index([tenantId, contactoId])
  @@map("etiqueta_asignaciones")
  @@schema("core")
}

// CAR-233 · Historial de correos del cliente. Sin @relation a Cuenta, Contacto, Negocio ni Tenant: las FK
// (SET NULL al borrar la entidad) y el trigger de mismo tenant van en el SQL de la migración.

/// Correo con un cliente: saliente de OPAI (cotización, factura, seguimiento) o entrante por Resend a la
/// dirección de la empresa (respuesta al reply-to o CCO). Remitente, destinatarios, asunto y texto son
/// contenido externo. Sin cuenta, contacto ni negocio = bandeja «sin asignar» (índice parcial en el SQL).
model CorreoCliente {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// "enviado" | "recibido"
  sentido       String
  /// "cotizacion" | "factura" | "seguimiento" | "buzon" (entró por la dirección de la empresa)
  origen        String
  /// Id del correo en el proveedor (entrantes): idempotencia del webhook, única por empresa.
  mensajeId     String?   @map("mensaje_id")
  remitente     String
  destinatarios String[]  @default([])
  asunto        String?
  texto         String
  cuentaId      String?   @map("cuenta_id") @db.Uuid
  contactoId    String?   @map("contacto_id") @db.Uuid
  negocioId     String?   @map("negocio_id") @db.Uuid
  /// Cómo se asoció: "origen" | "contacto" | "dominio" | "manual"; null = nunca se asoció.
  asociacion    String?
  /// Ámbito de acceso del hilo: "finanzas" en facturas y en las respuestas a ellas (ADR-016); null = sin restricción.
  ambito        String?
  asociadoPorId String?   @map("asociado_por_id") @db.Uuid
  asociadoEn    DateTime? @map("asociado_en") @db.Timestamptz(6)
  ocurridoEn    DateTime  @map("ocurrido_en") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, mensajeId])
  @@index([tenantId, cuentaId, ocurridoEn])
  @@index([tenantId, contactoId, ocurridoEn])
  @@index([tenantId, negocioId, ocurridoEn])
  @@map("correos_cliente")
  @@schema("core")
}

/// Dirección estable de la empresa para el registro de correos: `t<token>@respuestas.opai.cl` (reply-to
/// de los salientes y CCO del vendedor). El token es aleatorio de 128 bits; una por empresa.
model BuzonCorreo {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("buzones_correo")
  @@schema("core")
}
