// Módulo CPQ (CAR-119, Brief 10 · PR 10.1, ADR-042): cotizador que cuelga de un negocio de Comercial.
// Schema propio `cpq`. Toda tabla con tenant_id, RLS `tenant_isolation`, IDs uuid(7), columnas
// snake_case por @map. El tenant_id NO lleva @relation a Tenant (no se toca core.prisma): las FK a
// core.tenants, comercial.negocios y core.instalaciones van en el SQL de la migración, con el trigger
// `core.verificar_mismo_tenant`. Aún sin cálculo: venta, costos y líneas con precio llegan con el
// motor (Brief 08); la línea base (R68), los instrumentos y la configuración, en los PR 10.3 a 10.7.

/// Cotización: oferta a un cliente con código `CPQ-AAAA-NNN` (R54) que cuelga de un negocio (R18).
/// Las versiones guardan el estado; aquí vive lo que no cambia entre versiones.
model CpqCotizacion {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  codigo         String
  negocioId      String   @map("negocio_id") @db.Uuid
  titulo         String
  /// Otra cotización del mismo negocio de la que esta es alternativa (Opción A/B, R23).
  alternativaDeId String? @map("alternativa_de_id") @db.Uuid
  /// Una sola vigente por negocio (índice parcial en el SQL, R46).
  vigente        Boolean  @default(false)
  creadoPorId    String   @map("creado_por_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versiones CpqVersion[]

  @@unique([tenantId, codigo])
  @@index([tenantId, negocioId])
  @@map("cotizaciones")
  @@schema("cpq")
}

/// Versión de una cotización (R43). Una sola editable por cotización (índice parcial en el SQL);
/// enviar la congela. `estado` sigue R40: borrador, en_aprobacion, lista, enviada, aceptada,
/// rechazada, vencida, reemplazada, archivada.
model CpqVersion {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  cotizacionId      String    @map("cotizacion_id") @db.Uuid
  numero            Int
  estado            String    @default("borrador")
  /// "CLP" | "UF": solo presentación; el cálculo es siempre en CLP enteros (R25, R62).
  moneda            String    @default("CLP")
  validaHasta       DateTime? @map("valida_hasta") @db.Date
  /// "margen_sobre_venta" | "markup" | "margen_sobre_mano_de_obra". Solo con `cpq:costos.ver` (R59).
  margenModo        String    @default("margen_sobre_venta") @map("margen_modo")
  /// Porcentaje escalado (PCT_ESCALA). Nulo hasta que exista el motor. Solo con `cpq:costos.ver`.
  margenObjetivoPct Int?      @map("margen_objetivo_pct")
  /// CLP entero por mes. Lo escribe el motor (Brief 08); nulo mientras no exista.
  ventaMensualClp   Int?      @map("venta_mensual_clp")
  /// Control optimista de la edición concurrente (gana la primera, la segunda recarga).
  revision          Int       @default(1)
  enviadaEn         DateTime? @map("enviada_en") @db.Timestamptz(6)
  /// Resultado completo del motor al enviar (R-CPQ-010); JSON de `ResultadoCalculo` proyectado.
  calculoCongeladoJson String? @map("calculo_congelado_json")
  /// Marca y plantilla documental congeladas al enviar (CAR-135 addendum).
  marcaDocumentoVersion Int? @map("marca_documento_version")
  plantillaDocumentoId String? @map("plantilla_documento_id") @db.Uuid
  plantillaDocumentoVersion Int? @map("plantilla_documento_version")
  creadoPorId       String    @map("creado_por_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  cotizacion  CpqCotizacion  @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  secciones   CpqSeccion[]
  aprobaciones CpqAprobacion[]

  @@unique([cotizacionId, numero])
  @@index([tenantId, cotizacionId])
  @@index([tenantId, estado])
  @@map("versiones")
  @@schema("cpq")
}

/// Agrupación de líneas por instalación del negocio; `instalacionId` nulo = sección «Común» (R18).
model CpqSeccion {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  versionId     String   @map("version_id") @db.Uuid
  instalacionId String?  @map("instalacion_id") @db.Uuid
  nombre        String
  /// Margen de la sección escalado (PCT_ESCALA); nulo hereda el objetivo de la versión.
  margenPct     Int?     @map("margen_pct")
  orden         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  version CpqVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  lineas  CpqLinea[]

  @@index([tenantId, versionId])
  @@map("secciones")
  @@schema("cpq")
}

/// Lo cotizado dentro de una sección: puesto, ítem o adicional. Sin precios hasta el motor.
model CpqLinea {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  seccionId      String   @map("seccion_id") @db.Uuid
  /// "puesto" | "item" | "adicional"
  tipo           String
  grupo          String?
  nombre         String
  posiciones     Int      @default(1)
  /// "mensual" | "unico"
  recurrencia    String   @default("mensual")
  habilitada     Boolean  @default(true)
  visibleCliente Boolean  @default(true) @map("visible_cliente")
  orden          Int      @default(0)
  /// Patrón de turno (p. ej. 4x4); solo líneas tipo puesto.
  patron         String?
  horaInicio     String?  @map("hora_inicio")
  horaFin        String?  @map("hora_fin")
  diasCobertura  Int?     @map("dias_cobertura")
  /// Personas por posición sobrescritas (escala 10_000); exige `personasMotivo`.
  personasPorPosicionEscaladas Int? @map("personas_por_posicion_escaladas")
  personasMotivo String?  @map("personas_motivo")
  /// Sueldo base mensual CLP para el motor 07e; sin ingreso manual de costo empleador.
  sueldoBaseClp  Int?     @map("sueldo_base_clp")
  itemCodigo     String?  @map("item_codigo")
  cantidadEscalada Int?   @map("cantidad_escalada")
  rateoJson      String?  @map("rateo_json")
  precioUnitarioClp Int?  @map("precio_unitario_clp")
  margenPropioPct Int?    @map("margen_propio_pct")
  alcanceDotacion String? @map("alcance_dotacion")
  huellaJuegoValores String? @map("huella_juego_valores")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  seccion CpqSeccion @relation(fields: [seccionId], references: [id], onDelete: Cascade)

  @@index([tenantId, seccionId])
  @@map("lineas")
  @@schema("cpq")
}

/// Pedido y decisión de aprobación de margen sobre una versión (R41, R42).
model CpqAprobacion {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  versionId      String    @map("version_id") @db.Uuid
  /// "pendiente" | "aprobada" | "rechazada" | "retirada"
  estado         String    @default("pendiente")
  solicitadaPorId String   @map("solicitada_por_id") @db.Uuid
  comentario     String?
  decididaPorId  String?   @map("decidida_por_id") @db.Uuid
  motivo         String?
  decididaEn     DateTime? @map("decidida_en") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  version CpqVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([tenantId, versionId])
  @@map("aprobaciones")
  @@schema("cpq")
}

/// Último número usado por tenant y año para el código `CPQ-AAAA-NNN` (R54). Se incrementa con un
/// upsert atómico dentro de la transacción de crear: dos cotizaciones simultáneas no repiten número.
/// El importador de 1.0 fija `ultimo` al último número de 1.0 para que 2.0 continúe desde ahí.
model CpqCorrelativo {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  anio      Int
  ultimo    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, anio])
  @@map("correlativos")
  @@schema("cpq")
}

/// Categoría del catálogo CPQ por tenant (R55, R61): clase directo o indirecto.
model CpqCatalogoCategoria {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clave     String
  nombre    String
  clase     String   @default("directo")
  activa    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items CpqCatalogoItem[]

  @@unique([tenantId, clave])
  @@map("catalogo_categorias")
  @@schema("cpq")
}

/// Ítem del catálogo CPQ (R15–R16, R56): costo unitario y rateo por defecto; la línea guarda copia.
model CpqCatalogoItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  codigo           String
  nombre           String
  categoriaId      String   @map("categoria_id") @db.Uuid
  /// Referencia de tipo: item | cargo | uniforme | insumo (R-CPQ-013…019).
  grupo            String   @default("item")
  unidad           String   @default("unidad")
  modoCalculo      String   @default("mensual_fijo") @map("modo_calculo")
  rateoJson        String   @default("{\"tipo\":\"contrato\"}") @map("rateo_json")
  costoUnitarioClp Int      @default(0) @map("costo_unitario_clp")
  recurrencia      String   @default("mensual")
  visibleCliente   Boolean  @default(true) @map("visible_cliente")
  porDefecto       Boolean  @default(false) @map("por_defecto")
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  categoria CpqCatalogoCategoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@unique([tenantId, codigo])
  @@index([tenantId, categoriaId])
  @@map("catalogo_items")
  @@schema("cpq")
}

/// Marca documental CPQ por tenant (tipografía acotada, pie y condiciones); logos/colores en `core.perfil_empresa`.
model CpqMarcaDocumento {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String   @unique @map("tenant_id") @db.Uuid
  version             Int      @default(1)
  /// "inter" | "helvetica" | "times"
  tipografia          String   @default("inter")
  piePagina           String?  @map("pie_pagina")
  condicionesDefault  String?  @map("condiciones_default")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  revisiones CpqMarcaDocumentoRevision[]

  @@map("marca_documento")
  @@schema("cpq")
}

model CpqMarcaDocumentoRevision {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  marcaDocumentoId   String   @map("marca_documento_id") @db.Uuid
  version            Int
  tipografia         String
  piePagina          String?  @map("pie_pagina")
  condicionesDefault String?  @map("condiciones_default")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  marca CpqMarcaDocumento @relation(fields: [marcaDocumentoId], references: [id], onDelete: Cascade)

  @@unique([marcaDocumentoId, version])
  @@map("marca_documento_revisiones")
  @@schema("cpq")
}

/// Plantilla de documento CPQ (cotización v1); bloques ordenables sin HTML libre.
model CpqPlantillaDocumento {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// "cotizacion" (propuesta técnica y factura después).
  tipo        String   @default("cotizacion")
  /// "clasica" | "ejecutiva" | "compacta"
  base        String   @default("clasica")
  bloquesJson String   @map("bloques_json")
  version     Int      @default(1)
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  revisiones CpqPlantillaDocumentoRevision[]

  @@index([tenantId, tipo])
  @@map("plantillas_documento")
  @@schema("cpq")
}

model CpqPlantillaDocumentoRevision {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  plantillaDocumentoId String  @map("plantilla_documento_id") @db.Uuid
  version             Int
  base                String
  bloquesJson         String   @map("bloques_json")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plantilla CpqPlantillaDocumento @relation(fields: [plantillaDocumentoId], references: [id], onDelete: Cascade)

  @@unique([plantillaDocumentoId, version])
  @@map("plantillas_documento_revisiones")
  @@schema("cpq")
}
