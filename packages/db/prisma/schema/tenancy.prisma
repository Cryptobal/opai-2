// Pertenencia, invitaciones, API keys, módulos por tenant y telemetría (Brief 01).
// Todas llevan tenant_id y RLS `tenant_isolation`; `memberships` además `user_self`.

model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// "owner" | "admin" | "gerente" | "supervisor" | "viewer" (ADR-016)
  rol       String
  /// Rol personalizado del tenant (ADR-022). null = el rol base de `rol`. Define los permisos.
  roleId    String?  @map("role_id") @db.Uuid
  /// Portales a los que accede: "erp" | "supervisor" | "trabajador" | "terreno" | "cliente".
  portales  String[]
  /// Portal donde empezar tras el login o al cambiar de empresa (NÚCLEO-D1). null = el primero de
  /// `portales`. Si deja de estar en `portales`, el destino cae al primero permitido.
  portalInicio String? @map("portal_inicio")
  /// "activa" | "suspendida"
  estado    String   @default("activa")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  /// Restrict (CAR-45): borrar un usuario no arrastra sus membresías; la baja es por `estado`.
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  rolTenant   Rol?               @relation(fields: [roleId], references: [id])
  excepciones PermisoExcepcion[]
  /// Instalaciones a cargo si el rol acota por filas (supervisor, ADR-022 · Brief 07c B3).
  instalacionesACargo SupervisorInstalacion[]
  /// Grupos o equipos de autorización a los que pertenece (CAR-251).
  gruposUsuarios      GrupoUsuarioMiembro[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
  @@schema("core")
}

model Invitation {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String
  rol             String
  portales        String[]
  /// Portal de inicio que fija quien invita (NÚCLEO-D1); pasa a la membresía al aceptar.
  portalInicio    String?   @map("portal_inicio")
  /// SHA-256 del token del enlace. El token nunca se guarda.
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  revocadaEn      DateTime? @map("revocada_en") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, email])
  @@map("invitations")
  @@schema("core")
}

model TenantModule {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  moduloId   String   @map("modulo_id")
  /// "trial" | "activo" | "suspendido"
  estado     String   @default("activo")
  activadoEn DateTime @default(now()) @map("activado_en") @db.Timestamptz(6)
  config     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduloId])
  @@map("tenant_modules")
  @@schema("core")
}

model ApiKey {
  id                      String    @id @default(uuid(7)) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  /// Usuario responsable: el agente actúa "vía" este usuario y hereda sus permisos.
  userId                  String    @map("user_id") @db.Uuid
  nombre                  String
  /// Inicio visible de la key ("opai_gard_ab12") para reconocerla en la lista.
  prefijo                 String
  /// SHA-256 de la key completa. El secreto se muestra una sola vez y no se guarda.
  hash                    String    @unique
  /// Módulos permitidos ("core", "crm", …) o "*".
  scopes                  String[]
  /// Principal detrás de la key (ADR-033): "usuario" (Brief 01) | "cuenta" | "persona" (fase 3) |
  /// "servicio" (Identidad de servicio t457u: agente del tenant sin dueño humano; no hereda rol).
  principalTipo           String    @default("usuario") @map("principal_tipo")
  principalId             String?   @map("principal_id") @db.Uuid
  /// Permisos finos de la key (ids del catálogo), subconjunto de los efectivos del responsable
  /// (Identidad de servicio t457u). Si `heredaPermisos`, se ignora y la key hereda los del rol.
  permisos                String[]  @default([])
  /// true = la key usa los permisos efectivos del responsable (compatibilidad, defecto). false = usa
  /// su lista `permisos`. Un principal "servicio" es siempre false (sus permisos salen solo de la key).
  heredaPermisos          Boolean   @default(true) @map("hereda_permisos")
  /// Presupuesto mensual de consumos en micro-USD (ADR-032). Null o 0 = sin límite.
  presupuestoMensualMicro BigInt?   @map("presupuesto_mensual_micro")
  ultimoUsoEn             DateTime? @map("ultimo_uso_en") @db.Timestamptz(6)
  expiraEn                DateTime? @map("expira_en") @db.Timestamptz(6)
  revocadaEn              DateTime? @map("revocada_en") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  autonomia ApiKeyAutonomia[]
  gastoMes  GastoAgenteMes[]

  @@index([tenantId])
  @@map("api_keys")
  @@schema("core")
}

/// Telemetría de uso: una fila por ejecución de capacidad (lectura y escritura).
model UsageEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  /// "user" | "agent" | "system"
  actorType  String   @map("actor_type")
  portal     String?
  modulo     String
  capability String
  efecto     String
  dryRun     Boolean  @map("dry_run")
  ok         Boolean
  duracionMs Int      @map("duracion_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, modulo])
  @@map("usage_events")
  @@schema("core")
}
