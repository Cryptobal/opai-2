// Módulo Desempeño (CAR-306, ADR-094): scorecard por cargo. Schema propio `desempeno`.
// Toda tabla con tenant_id, RLS `tenant_isolation`, IDs uuid(7), columnas snake_case por @map. El
// tenant_id y el cargo NO llevan @relation al núcleo (no se toca maestros.prisma): las FK a
// core.tenants y a core.cargos (compuesta por empresa) van en el SQL de la migración.

/// Una versión del scorecard de un cargo. Rige desde `vigenteDesde` (mes "aaaa-mm") hasta que otra
/// versión publicada la reemplace. Un cambio nunca altera un mes ya medido: crea una versión que rige
/// desde el mes siguiente.
model DesempenoScorecard {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  cargoId            String    @map("cargo_id") @db.Uuid
  /// Primer mes en que rige, "aaaa-mm" en la zona de la empresa.
  vigenteDesde       String    @map("vigente_desde")
  /// "borrador" | "publicado". Solo las publicadas cuentan para el resultado.
  estado             String    @default("borrador")
  /// La persona ve su propio resultado.
  personaVeResultado Boolean   @default(true) @map("persona_ve_resultado")
  /// La persona ve su posición en el equipo.
  personaVeRanking   Boolean   @default(false) @map("persona_ve_ranking")
  publicadoEn        DateTime? @map("publicado_en") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  indicadores DesempenoScorecardIndicador[]

  @@unique([tenantId, cargoId, vigenteDesde])
  @@unique([tenantId, id])
  @@map("scorecards")
  @@schema("desempeno")
}

/// Indicador del catálogo del núcleo dentro de una versión del scorecard, con su meta y su peso.
model DesempenoScorecardIndicador {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  scorecardId String   @map("scorecard_id") @db.Uuid
  /// Id del indicador en el catálogo (`<modulo>.<nombre>`).
  indicador   String
  meta        Decimal  @db.Decimal(18, 4)
  /// Peso en puntos porcentuales (1 a 100). Para publicar, los pesos suman 100.
  peso        Int
  orden       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  scorecard DesempenoScorecard @relation(fields: [tenantId, scorecardId], references: [tenantId, id], onDelete: Cascade)

  @@unique([scorecardId, indicador])
  @@index([tenantId, scorecardId])
  @@map("scorecard_indicadores")
  @@schema("desempeno")
}

/// Indicador propio de la empresa (CAR-313): lo arma sobre hechos que los módulos declaran. La
/// definición, el sentido y la meta viven en sus versiones; esta fila guarda lo que no cambia el cálculo.
model DesempenoIndicadorPropio {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  nombre       String
  descripcion  String?
  archivadoEn  DateTime? @map("archivado_en") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  versiones DesempenoIndicadorPropioVersion[]

  @@unique([tenantId, id])
  @@map("indicadores_propios")
  @@schema("desempeno")
}

/// Versión de la definición de un indicador propio. Rige desde `vigenteDesde` (mes "aaaa-mm"), igual
/// que el scorecard: cambiar la definición no altera un mes ya medido.
model DesempenoIndicadorPropioVersion {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  indicadorId  String    @map("indicador_id") @db.Uuid
  vigenteDesde String    @map("vigente_desde")
  /// "borrador" | "publicado".
  estado       String    @default("borrador")
  /// Forma de cálculo y hechos (configuración versionada, ADR-021). La valida y evalúa el dominio.
  definicion   Json
  /// Unidad del resultado, derivada de la definición al guardar.
  unidad       String
  /// "mayor" | "menor": si más es mejor o menos es mejor. Va en la versión porque cambia el logro.
  sentido      String
  metaSugerida Decimal   @map("meta_sugerida") @db.Decimal(18, 4)
  publicadoEn  DateTime? @map("publicado_en") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  indicador DesempenoIndicadorPropio @relation(fields: [tenantId, indicadorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, indicadorId, vigenteDesde])
  @@map("indicador_propio_versiones")
  @@schema("desempeno")
}

/// Mes cerrado (CAR-322): su resultado quedó guardado y ya no se recalcula. No se reabre.
model DesempenoPeriodoCerrado {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// "aaaa-mm" en la zona de la empresa.
  periodo    String
  /// "manual" (lo cerró una persona) | "automatico" (trabajo diario).
  origen     String
  /// Usuario que lo cerró; null si lo cerró el trabajo diario.
  cerradoPor String?  @map("cerrado_por") @db.Uuid
  /// Cuántas personas quedaron con resultado guardado.
  personas   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  resultados DesempenoResultadoCerrado[]

  @@unique([tenantId, periodo])
  @@map("periodos_cerrados")
  @@schema("desempeno")
}

/// Resultado de una persona en un mes cerrado, con el cargo, la jefatura y la versión del scorecard
/// de ese mes. Inmutable: solo se borra al anonimizar a la persona.
model DesempenoResultadoCerrado {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  periodo       String
  personaId     String   @map("persona_id") @db.Uuid
  cargoId       String   @map("cargo_id") @db.Uuid
  jefePersonaId String?  @map("jefe_persona_id") @db.Uuid
  scorecardId   String   @map("scorecard_id") @db.Uuid
  vigenteDesde  String   @map("vigente_desde")
  /// 0 a 120; null si no hubo datos en ningún indicador.
  puntaje       Decimal? @db.Decimal(7, 2)
  /// Porcentaje del scorecard (por peso) que tuvo datos.
  cobertura     Decimal  @db.Decimal(5, 2)
  /// Detalle por indicador tal como quedó al cerrar (nombre, unidad, meta, peso, valor, logro).
  indicadores   Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  periodoCerrado DesempenoPeriodoCerrado @relation(fields: [tenantId, periodo], references: [tenantId, periodo], onDelete: Cascade)

  @@unique([tenantId, periodo, personaId])
  @@index([tenantId, periodo, cargoId])
  @@map("resultados_cerrados")
  @@schema("desempeno")
}
