// Terreno (CAR-78, Operaciones · Base · Code). Identidad de terreno: RUT + PIN de 6 dígitos como
// mecanismo secundario siempre disponible y sin biometría (D-02, Res. Ex. 38 art. 57). Las FKs a
// `core.tenants` y `core.personas` viven en la migración (como en `rendiciones`): no se toca
// `maestros.prisma` para declarar la relación inversa.

/// Credencial de terreno de una persona: el PIN solo existe como hash scrypt (mismo formato que las
/// contraseñas de Better Auth), nunca en claro. Una por persona y empresa. `rut` es una copia canónica
/// del RUT de la persona para que el ingreso la encuentre sin tenant fijado (función SECURITY DEFINER);
/// el ingreso la contrasta con la persona dentro de la empresa antes de aceptarla.
model CredencialTerreno {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  personaId       String    @unique @map("persona_id") @db.Uuid
  rut             String
  pinHash         String    @map("pin_hash")
  intentosFallidos Int      @default(0) @map("intentos_fallidos")
  bloqueadoHasta  DateTime? @map("bloqueado_hasta") @db.Timestamptz(6)
  pinCambiadoEn   DateTime? @map("pin_cambiado_en") @db.Timestamptz(6)
  /// El PIN lo fijó RR. HH.: el trabajador debe cambiarlo en su primer ingreso.
  debeCambiar     Boolean   @default(true) @map("debe_cambiar")
  /// Usuario (RR. HH.) que lo asignó o restableció por última vez.
  asignadoPor     String?   @map("asignado_por") @db.Uuid
  asignadoEn      DateTime? @map("asignado_en") @db.Timestamptz(6)
  /// Preparación de T-04 (D-01): el teléfono personal se habilita por persona. El flujo de
  /// consentimiento y su costo van con Face ID; aquí solo existe la bandera, apagada por defecto.
  telefonoPersonalHabilitado Boolean @default(false) @map("telefono_personal_habilitado")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([rut])
  @@map("credenciales_terreno")
  @@schema("core")
}

/// Dispositivo de terreno emparejado a UNA instalación (CAR-78 · B2, D-01: el kiosco es el canal
/// principal). Es un principal propio: se identifica con un token aleatorio de 256 bits guardado solo como
/// HMAC. Revocarlo corta el acceso en su siguiente petición.
model Dispositivo {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  instalacionId  String    @map("instalacion_id") @db.Uuid
  /// Identificador visible (DSP-0042), correlativo por empresa.
  identificador  String
  nombre         String?
  /// "activo" | "revocado"
  estado         String    @default("activo")
  tokenHash      String    @unique @map("token_hash")
  emparejadoEn   DateTime  @default(now()) @map("emparejado_en") @db.Timestamptz(6)
  emparejadoPor  String?   @map("emparejado_por") @db.Uuid
  revocadoEn     DateTime? @map("revocado_en") @db.Timestamptz(6)
  revocadoPor    String?   @map("revocado_por") @db.Uuid
  ultimoContacto DateTime? @map("ultimo_contacto") @db.Timestamptz(6)
  versionApp     String?   @map("version_app")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, identificador])
  @@index([tenantId, instalacionId])
  @@map("dispositivos")
  @@schema("core")
}

/// Código de 6 caracteres que genera el ERP para emparejar un dispositivo: vence a los 10 minutos y es de
/// un solo uso. Solo se guarda su HMAC.
model CodigoEmparejamiento {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  instalacionId String    @map("instalacion_id") @db.Uuid
  codigoHash    String    @unique @map("codigo_hash")
  venceEn       DateTime  @map("vence_en") @db.Timestamptz(6)
  usadoEn       DateTime? @map("usado_en") @db.Timestamptz(6)
  creadoPor     String?   @map("creado_por") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, instalacionId])
  @@map("codigos_emparejamiento")
  @@schema("core")
}

/// Hecho que un equipo de terreno capturó (posiblemente sin señal) y envió en lote (CAR-78 · B3). Solo
/// inserción: nada se edita ni se borra, una corrección es un hecho nuevo (ADR-023). La hora del servidor
/// (`recibido_en`) manda; `hora_corregida` lleva la hora del equipo a la del servidor con el desfase del envío.
model HechoTerreno {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  dispositivoId    String   @map("dispositivo_id") @db.Uuid
  instalacionId    String   @map("instalacion_id") @db.Uuid
  /// Clave de idempotencia que genera el equipo: reenviar el mismo hecho no lo duplica.
  clave            String   @db.Uuid
  /// Tipo de la lista blanca (`terreno.latido`, y los que declaren Rondas, Asistencia, Novedades y Acceso).
  tipo             String
  payload          Json
  /// Persona elegida en «¿Quién eres?»: declarada, no autenticada.
  personaId        String?  @map("persona_id") @db.Uuid
  horaHecho        DateTime @map("hora_hecho") @db.Timestamptz(6)
  horaEnvio        DateTime @map("hora_envio") @db.Timestamptz(6)
  recibidoEn       DateTime @default(now()) @map("recibido_en") @db.Timestamptz(6)
  /// recibido_en − hora_envio, en segundos (positivo: el equipo va atrasado).
  desfaseSegundos  Int      @map("desfase_segundos")
  horaCorregida    DateTime @map("hora_corregida") @db.Timestamptz(6)
  desfaseAlto      Boolean  @default(false) @map("desfase_alto")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, dispositivoId, clave])
  @@index([tenantId, instalacionId, horaCorregida(sort: Desc)])
  @@map("hechos_terreno")
  @@schema("core")
}

/// Rostro enrolado de una persona (CAR-78 · B4, D-02: el rostro es el mecanismo principal y el PIN el
/// secundario). OPAI no guarda la imagen ni la plantilla: solo la referencia opaca del proveedor, cifrada con
/// la DEK de la empresa (campo sensible). Una por persona. Existe mientras el consentimiento
/// `biometria_asistencia` esté vigente: revocarlo borra la referencia aquí y en el proveedor.
model EnrolamientoBiometrico {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  personaId          String   @unique @map("persona_id") @db.Uuid
  /// Consentimiento (hecho "otorgado") que habilitó este enrolamiento.
  consentimientoId   String   @map("consentimiento_id") @db.Uuid
  proveedor          String
  referenciaCifrada  String   @map("referencia_cifrada")
  enroladoPor        String?  @map("enrolado_por")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("enrolamientos_biometricos")
  @@schema("core")
}

/// Libro de novedades de una instalación, en el núcleo (CAR-77, ADR-024 nota del 29-oct-2026): una sola tabla
/// para todos los módulos que dejan novedades (Rondas hoy; Control de acceso y Central después), sin copias. Una
/// novedad grave es el incidente de terreno. `numero` lo asigna un trigger, correlativo por empresa (NOV-0001).
/// Las referencias a Rondas (`ejecucion_id`, `punto_id`, `tipo_incidente_id`) no llevan FK: el núcleo no depende
/// de un módulo (el trigger `mismo_tenant` sí verifica que sean de la misma empresa). Reemplaza a `rondas.novedades`, que queda sin escrituras hasta retirarse.
model LibroNovedad {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  numero          Int      @default(0)
  instalacionId   String   @map("instalacion_id") @db.Uuid
  /// Módulo que la dejó: "rondas" | "acceso" | "central" | "terreno".
  modulo          String   @default("terreno")
  /// "ronda" | "punto" | "manual".
  origen          String   @default("manual")
  ejecucionId     String?  @map("ejecucion_id") @db.Uuid
  puntoId         String?  @map("punto_id") @db.Uuid
  tipoIncidenteId String?  @map("tipo_incidente_id") @db.Uuid
  /// "baja" | "media" | "alta" (alta = incidente).
  gravedad        String   @default("media")
  resumen         String
  detalle         String?
  /// "abierta" | "en_atencion" | "resuelta" | "cerrada" | "derivada".
  estado          String   @default("abierta")
  /// Equipo de terreno que la envió (si llegó por la cola).
  dispositivoId   String?  @map("dispositivo_id") @db.Uuid
  /// Persona declarada en «¿Quién eres?» del equipo (no autenticada).
  personaId       String?  @map("persona_id") @db.Uuid
  /// Usuario que la registró en línea (ERP o portal), si no vino de un equipo.
  usuarioId       String?  @map("usuario_id") @db.Uuid
  /// Hora del hecho llevada a la del servidor (la del equipo corregida por el desfase del envío).
  horaHecho       DateTime @default(now()) @map("hora_hecho") @db.Timestamptz(6)
  idempotencyKey  String?  @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, numero])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, instalacionId, horaHecho(sort: Desc)])
  @@index([tenantId, horaHecho(sort: Desc), id(sort: Desc)])
  @@map("libro_novedades")
  @@schema("core")
}
