// Esquema de OPAI 2.0. Un schema de Postgres por módulo; `core` para el núcleo (ADR-003).
// Reglas: IDs uuid(7), columnas snake_case, tenant_id en toda tabla de negocio, RLS forzada.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // "comercial" es el schema del módulo Comercial (Brief 07 · PR 1). Prisma exige declarar aquí todo
  // schema usado por un @@schema; es el único cambio en core.prisma (no se tocan sus modelos). Las
  // tablas de comercial viven en packages/db/prisma/schema/comercial.prisma; "rondas" es el módulo
  // de rondas (CAR-72). "core_firma" es la firma electrónica del núcleo (firma.md, PR 1); sus tablas
  // viven en schema/firma.prisma.
  schemas  = ["core", "comercial", "rondas", "core_firma", "tickets", "portal_trabajador", "portal_cliente", "nomina", "finanzas", "pauta", "cpq", "rendiciones", "asistencia", "acceso"]
}

/// Empresa cliente de OPAI. No lleva tenant_id: es el tenant. Se protege por permisos de aplicación.
model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  nombre    String
  /// "seguridad" | "aseo" | "outsourcing" | "mantenimiento" (ADR-006)
  vertical  String
  timezone  String   @default("America/Santiago")
  /// "trial" | "activo" | "suspendido". Suspendido bloquea el ingreso de sus miembros.
  estado    String   @default("trial")
  /// Corte de la importación desde 1.0: con valor, `aplicar` se rechaza salvo reimportación del operador.
  importacionCerradaEn DateTime? @map("importacion_cerrada_en") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  auditEvents        AuditEvent[]
  auditoriaCabeza    AuditoriaCabeza?
  memberships        Membership[]
  roles              Rol[]
  permisoExcepciones PermisoExcepcion[]
  modules            TenantModule[]
  apiKeys            ApiKey[]
  invitations        Invitation[]
  usage              UsageEvent[]

  // Brief 02: maestros, documentos y servicios del núcleo.
  cuentas                 Cuenta[]
  cuentasRepresentantes   CuentaRepresentante[]
  cuentasReferencias      CuentaReferencia[]
  siiContribuyentes       SiiContribuyente[]
  contactos               Contacto[]
  instalaciones           Instalacion[]
  cargos                  Cargo[]
  puestos                 Puesto[]
  personas                Persona[]
  vinculos                VinculoLaboral[]
  estructuras             EstructuraSueldo[]
  estructurasItems        EstructuraItem[]
  idsExternos             IdExterno[]
  documentoTipos          DocumentoTipo[]
  documentos              Documento[]
  documentoVinculos       DocumentoVinculo[]
  perfil                  PerfilEmpresa?
  ajustes                 Ajuste[]
  eventos                 Evento[]
  eventosEntregas         EventoEntrega[]
  trabajos                Trabajo[]
  plantillas              Plantilla[]
  notificacionReglas      NotificacionRegla[]
  notificaciones          Notificacion[]
  novedadesLectura        NovedadLectura[]
  envios                  Envio[]
  integraciones           Integracion[]
  secretos                Secreto[]
  clave                   ClaveTenant?
  consumos                Consumo[]
  consumosDiarios         ConsumoDiario[]
  idempotencias           Idempotencia[]
  aprobaciones            Aprobacion[]
  apiKeysAutonomia        ApiKeyAutonomia[]
  gastosAgenteMes         GastoAgenteMes[]
  agenteConversaciones    AgenteConversacion[]
  bitacora                Bitacora[]
  bitacoraCabeza          BitacoraCabeza?
  comprobantes            Comprobante[]
  supervisorInstalaciones SupervisorInstalacion[]

  // Brief 07d · Ley 21.719 (cumplimiento por diseño).
  dpaAceptaciones      DpaAceptacion[]
  consentimientos      Consentimiento[]
  solicitudesArco      SolicitudArco[]
  incidentes           Incidente[]
  retencionEjecuciones RetencionEjecucion[]

  // Brief 07b · PR 4 (anexo de contrato en borrador).
  anexosContrato AnexoContrato[]
  personasPrevision PersonaPrevision[]
  personasPago PersonaPago[]
  personasPagoSolicitudes PersonaPagoSolicitud[]
  personasUniforme PersonaUniforme[]
  personasUniformeEntregas PersonaUniformeEntrega[]
  personasJornadaDt PersonaJornadaDt[]
  personasOs10 PersonaOs10[]
  personasContactoLaboral PersonaContactoLaboral[]

  @@map("tenants")
  @@schema("core")
}

/// Ventana de rate limit centralizado (NÚCLEO-B). No es dato de tenant (sin tenant_id ni RLS, como
/// `login_intentos`): es infraestructura global. `opai_app` NO la lee ni la escribe directo (REVOKE en
/// la migración); el acceso pasa solo por las funciones `SECURITY DEFINER` `core.rate_limit_consumir`
/// (upsert atómico que cuenta y decide) y `core.rate_limit_purgar` (la llama el cron). La `clave` es el
/// hash SHA-256 de «ámbito:identificador»: nunca la API key ni la IP en claro (Ley 21.719).
model RateLimitVentana {
  clave         String   @id
  ventanaInicio DateTime @map("ventana_inicio") @db.Timestamptz(6)
  n             Int
  actualizado   DateTime @db.Timestamptz(6)

  @@index([actualizado])
  @@map("rate_limit_ventanas")
  @@schema("core")
}

/// Auditoría append-only y encadenada por tenant (ADR-004, auditoría del 26-oct-2026 pedida por
/// Carlos, ADR-052): toda capacidad con efecto distinto de lectura escribe aquí, en la MISMA
/// transacción que su escritura de negocio (`executeCapability`, ADR-052 §1). La migración
/// revoca UPDATE/DELETE a `opai_app` (inmutable para la app; el dueño conserva el acceso para
/// scripts y para la prueba de alteración de `verificarAuditoria`). `seq`/`hashAnterior`/`hash`
/// encadenan los eventos del tenant (mismo algoritmo que `Bitacora`, `@opai/domain`); `hashCanon`
/// congela la forma canónica ya hasheada (tenant, seq, actor, capability, entidad, createdAt y un
/// **digest** SHA-256 del payload, no el payload crudo). Verificar recalcula el canon desde la fila;
/// una anonimización futura necesita un protocolo explícito de integridad (fuera de este PR).
model AuditEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// "user" | "agent" | "system"
  actorType    String   @map("actor_type")
  actorId      String?  @map("actor_id")
  /// Usuario responsable cuando el actor es un agente ("agente vía usuario").
  viaUserId    String?  @map("via_user_id")
  /// Id de la capacidad, por ejemplo "crm.lead.create".
  capability   String
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id")
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Secuencia por tenant (1, 2, 3…). `Int`, no `BigInt`: igual que `Bitacora.seq` y a propósito,
  /// para que las filas sigan siendo `JSON.stringify`-ables sin un reemplazador de BigInt (2.1 mil
  /// millones de escrituras por tenant alcanza de sobra). ADR-052.
  seq          Int      @map("seq")
  /// Hash del eslabón anterior del mismo tenant (génesis = 64 ceros).
  hashAnterior String   @map("hash_anterior")
  /// sha256(hashAnterior + "\n" + hashCanon). Columna que verifica la cadena.
  hash         String
  /// Forma canónica del eslabón; la verificación la contrasta con el contenido actual de la fila.
  hashCanon    String   @map("hash_canon")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, seq])
  @@index([tenantId, createdAt])
  @@map("audit_events")
  @@schema("core")
}

/// Última verificación de la cadena de `audit_events` por tenant (ADR-052), igual que
/// `BitacoraCabeza` para la bitácora de hechos regulados.
model AuditoriaCabeza {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @unique @map("tenant_id") @db.Uuid
  ultimoSeq      Int?      @map("ultimo_seq")
  verificadaEn   DateTime? @map("verificada_en") @db.Timestamptz(6)
  verificacionOk Boolean?  @map("verificacion_ok")
  ultimoHash     String?   @map("ultimo_hash")
  huellaPrefijo  String?   @map("huella_prefijo")
  revision       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("auditoria_cabezas")
  @@schema("core")
}

/// Aceptaciones del DPA (OPAI encargado ↔ tenant responsable, Ley 21.719; Brief 07d, §4.2).
/// Append-only: se guarda el historial, no solo la última, para probar qué versión del acuerdo
/// aceptó el tenant y cuándo. La migración revoca UPDATE/DELETE a opai_app (§6); corregir es
/// una fila nueva. El estado «vigente aceptado» se deriva de la última fila por tenant.
model DpaAceptacion {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// Versión del DPA de plataforma aceptada (ajuste `core.cumplimiento_dpa_version`, ADR-038).
  version        String
  /// Usuario que aceptó (id del actor, sin FK, igual que `audit_events.actor_id`).
  aceptadoPorId  String?  @map("aceptado_por_id") @db.Uuid
  /// Nombre y correo del aceptante al momento de aceptar, como prueba legible.
  aceptadoPor    String?  @map("aceptado_por")
  /// Referencia estable al texto aceptado: `<version>:sha256:<hash>` del texto vigente al aceptar.
  documentoRef   String?  @map("documento_ref")
  /// Texto exacto del DPA aceptado, guardado por fila. Como la tabla es append-only (sin UPDATE ni
  /// DELETE para opai_app), queda recuperable e inmutable: prueba a qué texto aceptó el tenant.
  documentoTexto String?  @map("documento_texto")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("dpa_aceptaciones")
  @@schema("core")
}

/// Consentimiento del titular para un fin accesorio (§16.2). Append-only: otorgar y revocar son
/// filas nuevas; el estado vigente por (titular, propósito) es la última fila. No se apoya en
/// consentimiento la relación laboral ni las obligaciones con la DT (t331u).
model Consentimiento {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// "persona" | "contacto": tipo de titular.
  titularTipo   String   @map("titular_tipo")
  titularId     String   @map("titular_id") @db.Uuid
  /// Fin accesorio (p. ej. "comunicaciones_comerciales"); base de licitud = consentimiento.
  proposito     String
  /// Versión del aviso de privacidad vigente al otorgar.
  versionAviso  String   @map("version_aviso")
  /// "otorgado" | "revocado". Revocar es una fila nueva (append-only).
  estado        String
  /// "interno" | "portal": de dónde vino. En 07d solo el registro interno.
  origen        String   @default("interno")
  nota          String?
  /// Nombre y correo de quien lo registró, como prueba legible (sin FK, igual que audit_events).
  registradoPor String?  @map("registrado_por")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, titularTipo, titularId, proposito, createdAt])
  @@map("consentimientos")
  @@schema("core")
}

/// Solicitud del titular (ARCO+, §4.4). Mutable: el estado avanza y las transiciones quedan en la
/// auditoría. El acceso y la portabilidad producen una exportación como documento del Núcleo.
model SolicitudArco {
  id                   String    @id @default(uuid(7)) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  /// Titular interno, si existe: "persona" | "contacto".
  titularTipo          String?   @map("titular_tipo")
  titularId            String?   @map("titular_id") @db.Uuid
  /// Correo y nombre del titular si aún no es un registro interno (§10).
  titularEmail         String?   @map("titular_email")
  titularNombre        String?   @map("titular_nombre")
  /// "acceso"|"rectificacion"|"cancelacion"|"oposicion"|"portabilidad"|"bloqueo"
  tipo                 String
  /// Detalle libre del titular (portal trabajador, Ley 21.719).
  detalle              String?
  /// Campos que el titular menciona (p. ej. teléfono, dirección).
  campos               Json?
  /// "recibida"|"en_proceso"|"resuelta"|"rechazada"
  estado               String    @default("recibida")
  /// Plazo legal calculado al recibir; null si los días aún no están configurados (§16.3).
  plazoEn              DateTime? @map("plazo_en") @db.Timestamptz(6)
  recibidaEn           DateTime  @default(now()) @map("recibida_en") @db.Timestamptz(6)
  /// Usuario responsable de atenderla (id del actor, sin FK).
  responsableId        String?   @map("responsable_id") @db.Uuid
  resultado            String?
  /// Documento de evidencia (p. ej. la exportación de acceso/portabilidad), mismo tenant.
  documentoEvidenciaId String?   @map("documento_evidencia_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, estado, plazoEn])
  @@map("solicitudes_arco")
  @@schema("core")
}

/// Incidente de seguridad y aviso de brecha (§16.5), manual. Append-only event-sourced: cada fila es
/// un hecho inmutable de un caso (`caso_id`); el estado vigente del caso es la última fila. "avanzar"
/// y "marcar notificado" agregan filas, no editan. Sin datos personales en claro (AGENTS.md).
model Incidente {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// Agrupa los hechos de un mismo incidente (= id del hecho "registro").
  casoId         String    @map("caso_id") @db.Uuid
  /// "registro" | "avance" | "aviso"
  evento         String
  /// Estado del caso tras este hecho: "abierto"|"en_evaluacion"|"notificado"|"cerrado"
  estado         String
  /// Registro: cuándo ocurrió y descripción, alcance y categorías de datos afectados.
  ocurridoEn     DateTime? @map("ocurrido_en") @db.Timestamptz(6)
  descripcion    String?
  alcance        String?
  datosAfectados String?   @map("datos_afectados")
  /// Aviso: a quién ("agencia"|"titulares"|texto), por qué canal, con qué plazo y evidencia.
  destinatario   String?
  canal          String?
  plazoEn        DateTime? @map("plazo_en") @db.Timestamptz(6)
  evidenciaDocId String?   @map("evidencia_doc_id") @db.Uuid
  nota           String?
  registradoPor  String?   @map("registrado_por")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, casoId, createdAt])
  @@map("incidentes")
  @@schema("core")
}

/// Registro de la política de retención (Ley 21.719, §4.5, §6): qué tabla, qué acción, cuántas filas
/// y cuándo. Append-only (la migración revoca UPDATE/DELETE a opai_app). Sin datos personales en
/// claro: solo contadores y, si fue a pedido de un titular, su id (pseudónimo) y la solicitud.
model RetencionEjecucion {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tabla       String
  /// "anonimizar" | "eliminar"
  accion      String
  /// "simulacion" (la política no está activa para el tenant) | "aplicada"
  modo        String
  /// "trabajo" (diario) | "titular" (anonimización puntual a pedido)
  origen      String    @default("trabajo")
  dias        Int?
  corte       DateTime? @db.Timestamptz(6)
  filas       Int
  titularTipo String?   @map("titular_tipo")
  titularId   String?   @map("titular_id") @db.Uuid
  solicitudId String?   @map("solicitud_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("retencion_ejecuciones")
  @@schema("core")
}

/// Corrida de importación desde OPAI 1.0 (simular o aplicar). Una `aplicar` es reversible.
model Importacion {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  sistema         String    @default("opai1")
  /// "api" | "instantanea" | "fixtures"
  origen          String
  versionContrato String    @map("version_contrato")
  /// "simular" | "aplicar"
  modo            String
  /// "en_curso" | "completada" | "fallida" | "revertida"
  estado          String    @default("en_curso")
  conteos         Json      @default("{}")
  lanzadaPorId    String?   @map("lanzada_por_id") @db.Uuid
  iniciadaEn      DateTime  @default(now()) @map("iniciada_en") @db.Timestamptz(6)
  terminadaEn     DateTime? @map("terminada_en") @db.Timestamptz(6)
  revertidaEn     DateTime? @map("revertida_en") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  filas ImportacionFila[]

  @@index([tenantId, iniciadaEn])
  @@map("importaciones")
  @@schema("core")
}

/// Qué hizo la corrida con cada fila de 1.0. `previos` guarda solo los campos completados.
model ImportacionFila {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  importacionId String   @map("importacion_id") @db.Uuid
  entidad       String
  id10          String   @map("id_1_0")
  id20          String?  @map("id_2_0") @db.Uuid
  /// "creado" | "completado" | "sin_cambio" | "omitido"
  accion        String
  motivo        String?
  previos       Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  importacion Importacion @relation(fields: [importacionId], references: [id], onDelete: Restrict)

  @@unique([importacionId, entidad, id10], map: "importaciones_filas_corrida_entidad_id_key")
  @@index([tenantId, entidad, id20])
  @@map("importaciones_filas")
  @@schema("core")
}
