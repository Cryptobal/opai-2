// Integraciones y secretos (ADR-027), consumos (ADR-031), agentes (ADR-032, ADR-033),
// bitácora encadenada y comprobantes (ADR-023). Brief 02.

model Integracion {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// "resend" | "google_maps" | "ia_anthropic" | "ia_openai" | "ia_google" | …
  proveedor      String
  /// "plataforma" | "propia"
  modalidad      String    @default("plataforma")
  /// "no_configurada" | "configurada" | "error"
  estado         String    @default("no_configurada")
  /// Configuración no secreta (remitente, dominio, modelos por clase…). Nunca credenciales.
  config         Json      @default("{}")
  ultimoTestEn   DateTime? @map("ultimo_test_en") @db.Timestamptz(6)
  ultimoError    String?   @map("ultimo_error")
  actualizadoPor String?   @map("actualizado_por") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  secretos Secreto[]

  @@unique([tenantId, proveedor])
  @@map("integraciones")
  @@schema("core")
}

/// Credencial del tenant cifrada con su DEK (AES-256-GCM). Nunca sale por API ni MCP.
model Secreto {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  integracionId String   @map("integracion_id") @db.Uuid
  nombre        String
  cifrado       Bytes
  iv            Bytes
  tag           Bytes
  /// Últimos 4 caracteres para mostrar enmascarado.
  sufijo        String
  creadoPor     String?  @map("creado_por") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  integracion Integracion @relation(fields: [integracionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, integracionId, nombre])
  @@map("secretos")
  @@schema("core")
}

/// DEK del tenant cifrada con la KEK de plataforma (envelope encryption, rotable).
model ClaveTenant {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @unique @map("tenant_id") @db.Uuid
  dekCifrada Bytes    @map("dek_cifrada")
  iv         Bytes
  tag        Bytes
  kekVersion Int      @map("kek_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("claves_tenant")
  @@schema("core")
}

/// Medidor de consumos (ADR-031). Reemplaza a usage_events: una fila por ejecución o recurso.
model Consumo {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  /// "capacidad.ejecucion" | "ia.tokens_entrada" | "geo.autocompletado" | "correo.enviado" | …
  recurso            String
  unidad             String
  cantidad           Int
  /// Micro-USD (1 USD = 1.000.000).
  costoUnitarioMicro Int      @default(0) @map("costo_unitario_micro")
  costoTotalMicro    Int      @default(0) @map("costo_total_micro")
  modulo             String
  capability         String?
  actorTipo          String   @map("actor_tipo")
  actorId            String?  @map("actor_id")
  viaUserId          String?  @map("via_user_id")
  apiKeyId           String?  @map("api_key_id") @db.Uuid
  portal             String?
  efecto             String?
  dryRun             Boolean? @map("dry_run")
  ok                 Boolean?
  duracionMs         Int?     @map("duracion_ms")
  referenciaTipo     String?  @map("referencia_tipo")
  referenciaId       String?  @map("referencia_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, recurso, createdAt])
  @@index([tenantId, apiKeyId, createdAt])
  @@index([tenantId, actorTipo, actorId, createdAt])
  @@map("consumos")
  @@schema("core")
}

model ConsumoDiario {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  dia             DateTime @db.Date
  recurso         String
  modulo          String
  /// "" = sin API key.
  apiKeyId        String   @default("") @map("api_key_id")
  cantidad        Int
  /// Micro-USD acumulados del día: BigInt (Int se desborda sobre ~2.147 USD).
  costoTotalMicro BigInt   @map("costo_total_micro")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, dia, recurso, modulo, apiKeyId])
  @@map("consumos_diarios")
  @@schema("core")
}

/// Lista de precios de plataforma por recurso (micro-USD por unidad), vigente desde una fecha.
model PrecioRecurso {
  id                 String   @id @default(uuid(7)) @db.Uuid
  recurso            String
  unidad             String
  costoUnitarioMicro Int      @map("costo_unitario_micro")
  vigenteDesde       DateTime @map("vigente_desde") @db.Date
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([recurso, vigenteDesde])
  @@map("precios_recursos")
  @@schema("core")
}

/// Cola de aprobaciones de agentes (ADR-032): lo irreversible espera a un humano.
model Aprobacion {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  apiKeyId       String?   @map("api_key_id") @db.Uuid
  agenteInternoId String?  @map("agente_interno_id")
  viaUserId      String    @map("via_user_id") @db.Uuid
  capability     String
  input          Json
  idempotencyKey String?   @map("idempotency_key")
  resumen        String
  /// "pendiente" | "aprobada" | "rechazada" | "vencida"
  estado         String    @default("pendiente")
  venceEn        DateTime  @map("vence_en") @db.Timestamptz(6)
  resueltaPor    String?   @map("resuelta_por") @db.Uuid
  resueltaEn     DateTime? @map("resuelta_en") @db.Timestamptz(6)
  motivo         String?
  resultado      Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, estado, createdAt])
  @@map("aprobaciones")
  @@schema("core")
}

/// Presupuesto mensual por API key (Identidad de servicio t457u, ADR-031/ADR-032). Contador atómico:
/// el chequeo y el consumo van en una transacción con guarda (gastado + costo <= tope), sin TOCTOU.
model GastoAgenteMes {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  apiKeyId     String?   @map("api_key_id") @db.Uuid
  agenteInternoId String? @map("agente_interno_id")
  /// Primer día del mes en UTC.
  periodo      DateTime  @db.Date
  /// Micro-USD gastados en el mes; nunca supera `topeMicro`.
  gastadoMicro BigInt    @default(0) @map("gastado_micro")
  /// Instantánea del tope de la key (micro-USD); se refresca si la key cambia su presupuesto.
  topeMicro    BigInt    @map("tope_micro")
  /// Marcas idempotentes de los avisos del mes (ADR-031): se emiten una sola vez.
  aviso80En    DateTime? @map("aviso_80_en") @db.Timestamptz(6)
  aviso100En   DateTime? @map("aviso_100_en") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, apiKeyId, periodo])
  @@unique([tenantId, agenteInternoId, periodo])
  @@map("gasto_agente_mes")
  @@schema("core")
}

model ApiKeyAutonomia {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  apiKeyId   String   @map("api_key_id") @db.Uuid
  capability String
  /// "directo" | "aprobacion"
  nivel      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, apiKeyId, capability])
  @@map("api_keys_autonomia")
  @@schema("core")
}

/// Bitácora encadenada append-only por tenant (ADR-023). Triggers impiden UPDATE/DELETE/TRUNCATE.
model Bitacora {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  seq          Int
  tipo         String
  entidadTipo  String?  @map("entidad_tipo")
  entidadId    String?  @map("entidad_id")
  payloadCanon String   @map("payload_canon")
  hashPrevio   String   @map("hash_previo")
  hash         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, seq])
  @@map("bitacora")
  @@schema("core")
}

model BitacoraCabeza {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @unique @map("tenant_id") @db.Uuid
  ultimoSeq      Int       @default(0) @map("ultimo_seq")
  ultimoHash     String    @map("ultimo_hash")
  verificadaEn   DateTime? @map("verificada_en") @db.Timestamptz(6)
  verificacionOk Boolean?  @map("verificacion_ok")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("bitacora_cabezas")
  @@schema("core")
}

/// Comprobante verificable públicamente en /verificar/<token> (sin datos personales).
model Comprobante {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tipo        String
  entidadTipo String   @map("entidad_tipo")
  entidadId   String   @map("entidad_id")
  hash        String
  token       String   @unique
  emitidoA    String?  @map("emitido_a")
  bitacoraSeq Int?     @map("bitacora_seq")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entidadTipo, entidadId])
  @@map("comprobantes")
  @@schema("core")
}

/// Idempotencia de escrituras (ADR-034): una clave por actor devuelve el mismo resultado al reintentar.
model Idempotencia {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// "user:<id>" | "agent:<id>" | "system"
  actor      String
  clave      String
  capability String
  /// SHA-256 del input canónico: la misma clave con otro input es un conflicto.
  huella     String
  /// "en_curso" | "hecha"
  estado     String   @default("en_curso")
  resultado  Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, actor, clave])
  @@index([tenantId, createdAt])
  @@map("idempotencias")
  @@schema("core")
}

/// Cola de aprobaciones de acciones `platform.*` pedidas por agentes (CAR-36). Vive FUERA de los
/// tenants: sin `tenant_id` ni RLS, como `core.users`. Solo la tocan las operaciones con nombre de
/// `accesoPlataforma()` (`packages/db/src/plataforma-aprobaciones.ts`), que solo recibe quien tiene
/// `platformRole`. `origenTenantId` es la empresa donde vive la key (para leer su nombre), no un
/// alcance: los owners y admins de esa empresa nunca ven estas filas.
model AprobacionPlataforma {
  id             String    @id @default(uuid(7)) @db.Uuid
  origenTenantId String?   @map("origen_tenant_id") @db.Uuid
  apiKeyId       String?   @map("api_key_id") @db.Uuid
  /// Nombre de la key al pedir (la key vive en otra empresa; no se consulta en cada lectura).
  agente         String
  /// Agente interno que la pidió (ADR-049), si la pidió uno; texto, como en `core.aprobaciones`.
  agenteInternoId String?  @map("agente_interno_id")
  viaUserId      String    @map("via_user_id") @db.Uuid
  capability     String
  input          Json
  idempotencyKey String?   @map("idempotency_key")
  resumen        String
  /// "pendiente" | "aprobada" | "rechazada" | "vencida"
  estado         String    @default("pendiente")
  venceEn        DateTime  @map("vence_en") @db.Timestamptz(6)
  resueltaPor    String?   @map("resuelta_por") @db.Uuid
  resueltaEn     DateTime? @map("resuelta_en") @db.Timestamptz(6)
  motivo         String?
  resultado      Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([estado, createdAt])
  @@index([apiKeyId, capability, idempotencyKey])
  @@map("aprobaciones_plataforma")
  @@schema("core")
}

/// Auditoría global, fuera de los tenants (CAR-36, CAR-41; preparada para CAR-42): sin
/// `tenant_id` ni RLS, append-only para `opai_app` y encadenada POR ÁMBITO con
/// `core.auditoria_global_append`, con el mismo esquema de hash que `core.audit_events`.
/// - `plataforma`: escrituras y lecturas `platform.*`, pedidos de aprobación y decisiones, con
///   `antes`/`despues` en los cambios globales (ajustes, precios). Solo se lee con `platformRole`.
/// - `seguridad` (CAR-42, aún sin escritor): login, logout, cambio y reseteo de contraseña y MFA;
///   `actorId` es el usuario, `capability` el tipo de evento (`seguridad.login`…), la IP va cifrada
///   (`ipCifrada`, nunca en claro) y `userAgent` recortado.
model AuditoriaGlobal {
  id               String   @id @default(uuid(7)) @db.Uuid
  /// "plataforma" | "seguridad": cada ámbito es una cadena propia (`seq` 1, 2, 3… por ámbito).
  ambito           String
  seq              Int
  actorType        String   @map("actor_type")
  actorId          String?  @map("actor_id")
  viaUserId        String?  @map("via_user_id")
  /// Capacidad (`platform.*`) o tipo de evento de seguridad.
  capability       String
  /// Empresa sobre la que actuó (tenantObjetivo), si la hay.
  tenantObjetivoId String?  @map("tenant_objetivo_id") @db.Uuid
  /// Empresa desde la que se operó (la de la key o la sesión), si la hay.
  origenTenantId   String?  @map("origen_tenant_id") @db.Uuid
  entityType       String?  @map("entity_type")
  entityId         String?  @map("entity_id")
  payload          Json?
  /// Estado anterior y nuevo de lo que cambió (CAR-41).
  antes            Json?
  despues          Json?
  /// IP cifrada con la clave de plataforma y user agent (CAR-42); nunca la IP en claro.
  ipCifrada        String?  @map("ip_cifrada")
  userAgent        String?  @map("user_agent")
  /// Fila de `core.audit_events` copiada por la migración de CAR-36 (la original queda en su cadena).
  origenEventoId   String?  @map("origen_evento_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  hashAnterior     String   @map("hash_anterior")
  hash             String
  hashCanon        String   @map("hash_canon")

  @@unique([ambito, seq])
  @@index([ambito, tenantObjetivoId, seq])
  @@index([ambito, capability, seq])
  @@index([ambito, actorId, seq])
  @@map("auditoria_global")
  @@schema("core")
}

/// Conversaciones del agente interno (CAR-120 PR 5b, spec agente R19). Privadas de la persona que las
/// tiene: el alcance por `user_id` se aplica en cada capacidad (ni owner ni admin las leen). Los
/// mensajes se guardan sin el token firmado del plan ni datos de terceros fuera del texto mostrado.
model AgenteConversacion {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  titulo          String
  /// Entidad desde la que se abrió ("cuenta" | "instalacion" | "negocio" | "persona"); sin contexto: null.
  contextoTipo    String?   @map("contexto_tipo")
  contextoId      String?   @map("contexto_id") @db.Uuid
  /// Lista ordenada de `{ rol: "usuario" | "agente", texto, pasos?, fecha }`; tope en la capacidad.
  mensajes        Json      @default("[]")
  archivadaEn     DateTime? @map("archivada_en") @db.Timestamptz(6)
  ultimaActividad DateTime  @default(now()) @map("ultima_actividad") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId, ultimaActividad(sort: Desc)])
  @@map("agente_conversaciones")
  @@schema("core")
}
