// Identidad (ADR-015). Modelos que espera el adaptador Prisma de Better Auth: User, Session,
// Account, Verification. No llevan tenant_id ni RLS: los protege la librería. La pertenencia
// a tenants es propia (Membership, con RLS) para que la segregación siga pasando por Postgres.

model User {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  /// "owner" | "support" | null — rol en la plataforma OPAI, no en un tenant (ADR-016).
  platformRole     String?  @map("platform_role")
  /// Segundo factor activo (NÚCLEO-F). Lo fija el plugin twoFactor de Better Auth tras verificar.
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions           Session[]
  accounts           Account[]
  memberships        Membership[]
  apiKeys            ApiKey[]
  twoFactor          TwoFactor?
  /// Excepciones de permiso que este usuario fijó (A18/A19); se desligan si se elimina (SET NULL).
  excepcionesFijadas PermisoExcepcion[]  @relation("excepcionesFijadas")
  /// OAuth del MCP (CAR-247): apps que la persona registró o autorizó y sus tokens.
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]

  @@map("users")
  @@schema("core")
}

// Segundo factor (TOTP + códigos de respaldo) del plugin twoFactor de Better Auth (NÚCLEO-F).
// Tabla de identidad como `users`: sin tenant_id ni RLS (la protege `opai_app` NOBYPASSRLS y el que
// solo `@opai/auth` la toca; nunca se lee desde capacidades de negocio). `secret` y `backup_codes`
// quedan cifrados por el plugin con `BETTER_AUTH_SECRET` (symmetricEncrypt): no se agrega ningún
// secreto nuevo. `failed_verification_count` y `locked_until` son el bloqueo por cuenta del paso de
// verificación (accountLockout del plugin). Una fila por usuario (user_id único).
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @unique @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
  @@schema("core")
}

// Registro append-only de cada intento de login (B1, Brief 07c). Es la única fuente del bloqueo por
// fuerza bruta: `@opai/auth` cuenta los fallos de contraseña en una ventana (por correo+IP, correo e
// IP) en vez de mutar un contador, así no hay carrera y cubre los correos que no existen. Para cerrar
// la carrera entre intentos simultáneos, el conteo y el alta van en una transacción bajo
// `pg_advisory_xact_lock`: el intento se inserta provisional (motivo `pendiente`, que cuenta como
// fallo) y el `after` lo resuelve con `core.marcar_login_intento` (SECURITY DEFINER). Sin datos
// personales en claro: el correo va como HMAC, nunca RUT ni PIN (Ley 21.719). IP y user agent quedan
// para la auditoría de acceso (B8). Sin tenant_id ni RLS (la identidad es global). `user_id` queda
// reservado (lo poblará B8); el flujo de login NO lo resuelve, para no abrir un oráculo de
// enumeración por tiempo —el intento se indexa por `correo_hash` (HMAC)—. Solo-anexar: `opai_app` no
// actualiza ni borra (REVOKE en la migración); la resolución del provisional y la purga las hacen
// funciones `SECURITY DEFINER`.
model LoginIntento {
  id         String   @id @default(uuid(7)) @db.Uuid
  correoHash String   @map("correo_hash")
  userId     String?  @map("user_id") @db.Uuid
  exito      Boolean
  /// "pendiente" (provisional) | "ok" | "reset" | "credenciales" | "bloqueada" | "suspendida" | otro código.
  motivo     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([correoHash, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("login_intentos")
  @@schema("core")
}

model Session {
  id            String   @id @default(uuid(7)) @db.Uuid
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  token         String   @unique
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  userId        String   @map("user_id") @db.Uuid
  /// Solo el servidor tras verificar TOTP/respaldo; nunca heredada de otra sesión ni del cliente.
  mfaVerified   Boolean  @default(false) @map("mfa_verified")
  /// Empresa elegida para autorizar una app por OAuth (CAR-247). Solo la fija el servidor tras
  /// validar la membresía activa; el proveedor la toma como `reference_id` del consentimiento.
  oauthTenantId String?  @map("oauth_tenant_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
  @@map("sessions")
  @@schema("core")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
  @@schema("core")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
  @@schema("core")
}
