// Identidad (ADR-015). Modelos que espera el adaptador Prisma de Better Auth: User, Session,
// Account, Verification. No llevan tenant_id ni RLS: los protege la librería. La pertenencia
// a tenants es propia (Membership, con RLS) para que la segregación siga pasando por Postgres.

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  /// "owner" | "support" | null — rol en la plataforma OPAI, no en un tenant (ADR-016).
  platformRole  String?  @map("platform_role")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions     Session[]
  accounts     Account[]
  memberships  Membership[]
  apiKeys      ApiKey[]
  loginBloqueo LoginBloqueo?

  @@map("users")
  @@schema("core")
}

// Protección contra fuerza bruta persistida por identidad (B1, Brief 07c; ADR-015). Cuelga de la
// identidad global `users`: sin tenant_id ni RLS, como `users`/`sessions`. Solo la gestiona
// `@opai/auth` en el flujo de login; no es una tabla de negocio. Umbrales fijos en código (§16.3).
model LoginBloqueo {
  userId         String    @id @map("user_id") @db.Uuid
  /// Fallos de contraseña consecutivos desde el último ingreso correcto o desde que venció la pausa.
  fallos         Int       @default(0)
  /// Mientras sea futura, el ingreso está pausado aunque la contraseña sea correcta.
  bloqueadoHasta DateTime? @map("bloqueado_hasta") @db.Timestamptz(6)
  ultimoIntento  DateTime? @map("ultimo_intento") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_bloqueos")
  @@schema("core")
}

// Registro append-only de cada intento de login (B1, Brief 07c). Sin datos personales en claro: el
// correo va en hash, nunca RUT ni PIN (Ley 21.719). IP y user agent quedan para la auditoría de
// acceso (B8). Sin tenant_id ni RLS (la identidad es global); `user_id` es null si no hay cuenta.
model LoginIntento {
  id         String   @id @default(uuid(7)) @db.Uuid
  correoHash String   @map("correo_hash")
  userId     String?  @map("user_id") @db.Uuid
  exito      Boolean
  /// "ok" | "credenciales" | "bloqueada" | "suspendida" | otro código de Better Auth.
  motivo     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([correoHash, createdAt])
  @@index([userId, createdAt])
  @@map("login_intentos")
  @@schema("core")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("core")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
  @@schema("core")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
  @@schema("core")
}
