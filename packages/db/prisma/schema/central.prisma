// Módulo Central de monitoreo (CAR-461, Brief 15b · PR 1, spec docs/2.0/modulos/central.md).
// Schema propio `central`. Toda tabla con tenant_id, RLS `tenant_isolation`, IDs uuid(7) y columnas
// snake_case por @map. Las FK a core.tenants, core.instalaciones, core.personas y core.users van en
// el SQL de la migración, sin relación Prisma cruzada (no se toca core.prisma).

/// Alerta (spec §2): el caso que la central atiende, de una instalación. Estados de §6. En el PR 1
/// solo nacen a mano (`origen = "manual"`); las reglas y señales llegan en el PR 3 (CAR-469).
model CentralAlerta {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  instalacionId  String    @map("instalacion_id") @db.Uuid
  /// Persona involucrada (guardia del turno), si la hay.
  personaId      String?   @map("persona_id") @db.Uuid
  titulo         String
  descripcion    String    @default("")
  /// "critica" | "alta" | "media" | "baja".
  severidad      String
  /// "manual" o el evento de la señal que la abrió (PR 3, p. ej. "rondas.emergencia").
  origen         String    @default("manual")
  /// "nueva" | "en_contacto" | "escalada" | "en_atencion" | "resuelta" | "falsa_alarma" | "pospuesta".
  estado         String    @default("nueva")
  /// Estado al que vuelve una alerta pospuesta (R4a).
  estadoPrevio   String?   @map("estado_previo")
  pospuestaHasta DateTime? @map("pospuesta_hasta") @db.Timestamptz(6)
  /// Nota de resolución o motivo de falsa alarma.
  notaCierre     String?   @map("nota_cierre")
  abiertaPorId   String?   @map("abierta_por_id") @db.Uuid
  /// Cadena que rige la alerta (null = plantilla por defecto) y paso en curso (0 = sin contactar).
  cadenaId       String?   @map("cadena_id") @db.Uuid
  pasoActual     Int       @default(0) @map("paso_actual")
  pasoVenceEn    DateTime? @map("paso_vence_en") @db.Timestamptz(6)
  /// Quién dijo «me hago cargo» y hasta cuándo tiene para resolver (R8).
  atencionPorId  String?   @map("atencion_por_id") @db.Uuid
  atencionVenceEn DateTime? @map("atencion_vence_en") @db.Timestamptz(6)
  /// Operador que tomó la alerta (R13): mientras esté tomada, el agente no actúa en ella.
  tomadaPorId    String?   @map("tomada_por_id") @db.Uuid
  tomadaEn       DateTime? @map("tomada_en") @db.Timestamptz(6)
  cerradaEn      DateTime? @map("cerrada_en") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  eventos  CentralAlertaEvento[]
  intentos CentralIntento[]

  @@unique([tenantId, id])
  @@index([tenantId, estado])
  @@index([tenantId, instalacionId])
  @@index([tenantId, instalacionId, personaId], map: "alertas_tenant_instalacion_persona_idx")
  @@map("alertas")
  @@schema("central")
}

/// Línea de tiempo de la alerta (R18), append-only: un trigger impide UPDATE y DELETE. Cada hecho
/// además queda encadenado en `core.bitacora` en la misma transacción.
model CentralAlertaEvento {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  alertaId  String   @map("alerta_id") @db.Uuid
  /// "abierta" | "resuelta" | "falsa_alarma" | "reabierta" | "pospuesta" | "reactivada".
  tipo      String
  /// "persona" | "agente" | "sistema".
  actorTipo String   @map("actor_tipo")
  /// Usuario humano (o responsable de la key del agente).
  actorId   String?  @map("actor_id") @db.Uuid
  nota      String?
  estadoDesde String? @map("estado_desde")
  estadoHacia String  @map("estado_hacia")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  alerta CentralAlerta @relation(fields: [tenantId, alertaId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, alertaId])
  @@map("alerta_eventos")
  @@schema("central")
}

/// Cadena de escalamiento (R7): por empresa, instalación y severidad. `pasos` se valida con Zod en la
/// capacidad (destinatario, canales, espera y si exige «me hago cargo»).
model CentralCadena {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  instalacionId    String?  @map("instalacion_id") @db.Uuid
  /// null = vale para toda severidad.
  severidad        String?
  pasos            Json
  plazoAtencionMin Int      @default(30) @map("plazo_atencion_min")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("cadenas")
  @@schema("central")
}

/// Intento de contacto dentro de una alerta (R7, R18): append-only, un trigger impide editarlo.
model CentralIntento {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  alertaId       String   @map("alerta_id") @db.Uuid
  /// Paso de la cadena (0 = contacto fuera de la cadena).
  paso           Int
  destinatarioId String?  @map("destinatario_id") @db.Uuid
  canal          String
  /// "avisado" (salió por un canal activo) | "apagado" (canal sin activar, R6) | "contesto" |
  /// "no_contesto" | "confirmo" | "rechazo".
  resultado      String
  nota           String?
  registradoPorId String? @map("registrado_por_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  alerta CentralAlerta @relation(fields: [tenantId, alertaId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, alertaId])
  @@map("intentos")
  @@schema("central")
}

/// Regla de vigilancia de la empresa (R1–R6): si una señal abre alertas y con qué severidad. Sin fila,
/// rige el catálogo por defecto (`modules/central/domain/senales.ts`), activo solo dentro de la cola.
model CentralRegla {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  evento    String
  severidad String
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, evento])
  @@map("reglas")
  @@schema("central")
}

/// Turno de central (R12, R15): quién está a cargo. Uno solo abierto o en entrega por empresa.
model CentralTurno {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  operadorId    String    @map("operador_id") @db.Uuid
  /// "abierto" | "en_entrega" | "cerrado".
  estado        String    @default("abierto")
  /// A quién se entrega (en_entrega) y nota de la entrega.
  entregaAId    String?   @map("entrega_a_id") @db.Uuid
  notaEntrega   String?   @map("nota_entrega")
  cerradoEn     DateTime? @map("cerrado_en") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, estado])
  @@map("turnos")
  @@schema("central")
}

/// Pausa del agente de central (R13), por instalación o para toda la empresa (instalacionId null).
model CentralPausa {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  instalacionId  String?   @map("instalacion_id") @db.Uuid
  pausadaPorId   String?   @map("pausada_por_id") @db.Uuid
  motivo         String?
  reanudadaPorId String?   @map("reanudada_por_id") @db.Uuid
  reanudadaEn    DateTime? @map("reanudada_en") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("pausas")
  @@schema("central")
}

/// Propuesta del agente (R10, CA3): una acción que el agente prepara y el responsable acepta o
/// rechaza con un toque. Al aceptarla se ejecuta con la identidad de la persona.
model CentralPropuesta {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  alertaId       String    @map("alerta_id") @db.Uuid
  /// "resolver" | "falsa_alarma" | "reabrir" | "posponer" | "bajar_severidad".
  accion         String
  nota           String?
  minutos        Int?
  severidad      String?
  /// "pendiente" | "aceptada" | "rechazada".
  estado         String    @default("pendiente")
  /// Key del agente que la propuso (null si la dejó una persona).
  apiKeyId       String?   @map("api_key_id") @db.Uuid
  propuestaPorId String?   @map("propuesta_por_id") @db.Uuid
  resueltaPorId  String?   @map("resuelta_por_id") @db.Uuid
  resueltaEn     DateTime? @map("resuelta_en") @db.Timestamptz(6)
  motivoRechazo  String?   @map("motivo_rechazo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, estado])
  @@index([tenantId, alertaId])
  @@map("propuestas")
  @@schema("central")
}
