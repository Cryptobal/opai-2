// Roles personalizados y excepciones de permisos por usuario (Brief 07c B2, ADR-016, ADR-022).
// Todas llevan tenant_id y RLS `tenant_isolation`. Un rol del tenant agrupa permisos del catálogo
// (subconjunto); los cinco roles base (ADR-016) siguen viviendo como string en `Membership.rol`.

/// Rol del tenant: conjunto de permisos del catálogo (`<modulo>:<accion>`, con comodín `*`).
/// `sistema` marca una plantilla provista por OPAI (p. ej. Central de monitoreo); las demás las
/// crean owner o admin. Un rol personalizado nunca otorga `platform:*` ni más de lo que su creador
/// tiene. Finanzas y nómina nacen fuera del conjunto y solo las concede un owner/admin (§16.2).
model Rol {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  nombre      String
  descripcion String?
  /// true: plantilla del sistema (no editable ni archivable por el tenant).
  sistema     Boolean   @default(false)
  /// Permisos/patrones del catálogo que concede. Vacío = rol sin acceso (válido).
  permisos    String[]
  archivadoEn DateTime? @map("archivado_en") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  memberships Membership[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
  @@map("roles")
  @@schema("core")
}

/// Excepción de permiso por usuario (ADR-022): concede o deniega un permiso puntual sobre su rol.
/// Denegar siempre gana. Ligada a la membresía; se borra con ella. La sábana A18/A19 muestra el
/// motivo y «Fijado por … · fecha»: por eso `motivo`, `creadoPor` y las fechas.
model PermisoExcepcion {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  permiso      String
  /// true = concede el permiso; false = lo deniega (gana sobre cualquier concesión del rol).
  conceder     Boolean
  /// Por qué se fijó (≤200). Null en filas previas; obligatorio al conceder/denegar (lo valida la capacidad).
  motivo       String?
  /// Usuario (global) que la fijó; null si ese usuario se eliminó (ON DELETE SET NULL).
  creadoPor    String?  @map("creado_por") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  membership       Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  creadoPorUsuario User?      @relation("excepcionesFijadas", fields: [creadoPor], references: [id], onDelete: SetNull)

  @@unique([membershipId, permiso])
  @@index([tenantId])
  @@index([creadoPor])
  @@map("permiso_excepciones")
  @@schema("core")
}
