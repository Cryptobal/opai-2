// Slack ↔ OPAI 2 (ADR-093, CAR-291). Instalación de la app «OPAI» en el espacio de Slack de cada
// empresa. El token del bot NO vive aquí: va cifrado en `core.secretos` (proveedor «slack», ADR-027).
// La configuración no secreta (canales, avisos, pánico) vive en `core.integraciones.config`.

/// Espacio de Slack ligado a la empresa. Una empresa tiene a lo más una instalación y un espacio
/// queda ligado a una sola empresa (`teamId` único global; ADR-093 §10). La resuelve, sin tenant, la
/// función `core.slack_instalacion_resolver` (SECURITY DEFINER) tras verificar la firma de Slack.
model SlackInstalacion {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  teamId       String   @unique @map("team_id")
  teamNombre   String   @map("team_nombre")
  botUserId    String   @map("bot_user_id")
  appId        String   @map("app_id")
  instaladoPor String?  @map("instalado_por") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("slack_instalaciones")
  @@schema("core")
}

/// Vínculo persona de OPAI ↔ usuario de Slack de la empresa (ADR-093, CAR-292). Lo llena el núcleo
/// buscando el correo de cada usuario interno con `users.lookupByEmail`. La FK compuesta a la
/// membresía impide un vínculo con alguien que no es de la empresa. «sin_vincular» guarda el motivo.
model SlackUsuario {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// "vinculado" | "sin_vincular"
  estado      String
  /// Id del usuario en Slack (U… o W…), solo si está vinculado.
  slackUserId String?  @map("slack_user_id")
  /// Por qué no se vinculó: "no_encontrado" | "invitado" | "desactivado" | "bot" | "otro_espacio" | "ya_ligado" | "error"
  motivo      String?
  revisadoEn  DateTime @map("revisado_en") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  membresia Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, estado])
  @@map("slack_usuarios")
  @@schema("core")
}

/// Mensaje padre de una instalación por canal y día (CAR-293): los avisos del día van en su hilo.
/// Nunca se crea un canal por instalación (ADR-093 §4).
model SlackHilo {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  canalId       String   @map("canal_id")
  instalacionId String   @map("instalacion_id") @db.Uuid
  fecha         DateTime @db.Date
  ts            String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, canalId, instalacionId, fecha])
  @@map("slack_hilos")
  @@schema("core")
}

/// Aviso de terreno a Slack (CAR-293): solo anomalías que la empresa activó. `clave` lo hace idempotente
/// (un aviso por hecho de origen). `gestion` es la verdad en OPAI de quién lo tomó o cerró (F4).
model SlackAviso {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// "atraso" | "ausencia" | "fuera_de_zona" | "sin_relevo" | "incidente" | "panico" | "mensaje_guardia"
  tipo          String
  clave         String
  instalacionId String?   @map("instalacion_id") @db.Uuid
  personaId     String?   @map("persona_id") @db.Uuid
  titulo        String
  detalle       String?
  enlace        String?
  canalId       String?   @map("canal_id")
  hiloTs        String?   @map("hilo_ts")
  ts            String?
  /// "pendiente" | "enviado" | "fallido"
  envio         String    @default("pendiente")
  error         String?
  /// "abierto" | "tomado" | "cerrado"
  gestion       String    @default("abierto")
  tomadoPor     String?   @map("tomado_por") @db.Uuid
  tomadoEn      DateTime? @map("tomado_en") @db.Timestamptz(6)
  cerradoPor    String?   @map("cerrado_por") @db.Uuid
  cerradoEn     DateTime? @map("cerrado_en") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, clave])
  @@index([tenantId, gestion, createdAt])
  @@index([tenantId, canalId, ts])
  @@map("slack_avisos")
  @@schema("core")
}
