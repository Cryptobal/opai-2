// Módulo Comercial — Negocios y Contactos (Brief 07 · PR 1, ADR-003/ADR-040). Un schema de Postgres
// por módulo: `comercial`. Toda tabla con tenant_id, RLS `tenant_isolation`, IDs uuid(7), columnas
// snake_case por @map. El tenant_id NO lleva @relation a Tenant (no se toca core.prisma): la FK a
// core.tenants va en el SQL. Las referencias a cuentas, instalaciones y contactos del núcleo usan
// relaciones entre schemas; la verificación de que apuntan al mismo tenant va por trigger en el SQL.

/// Embudo comercial configurable por tenant. Exactamente uno por_defecto por tenant.
model Embudo {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nombre    String
  porDefecto Boolean @default(false) @map("por_defecto")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  etapas   Etapa[]
  negocios Negocio[]

  @@index([tenantId])
  @@map("embudos")
  @@schema("comercial")
}

/// Etapa de un embudo. Exactamente una `ganada` y una `perdida` por embudo (índices parciales + regla
/// de negocio); el resto `abierta`. `exige` lista los requisitos de entrada (R9).
model Etapa {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  embudoId     String   @map("embudo_id") @db.Uuid
  nombre       String
  orden        Int      @default(0)
  /// "abierta" | "ganada" | "perdida"
  tipo         String   @default("abierta")
  /// 0–100. Por defecto de la etapa; editable en el negocio.
  probabilidad Int      @default(0)
  /// Tono del DS para el chip de estado: "neutral" | "success" | "danger" | "warning".
  tono         String   @default("neutral")
  /// Requisitos de entrada: "monto" | "fecha_cierre" | "cotizacion_enviada" | "inicio_servicio" | "motivo_perdida"
  exige        String[] @default([])
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  embudo          Embudo           @relation(fields: [embudoId], references: [id], onDelete: Cascade)
  negocios        Negocio[]
  historialDesde  HistorialEtapa[] @relation("historial_de")
  historialHacia  HistorialEtapa[] @relation("historial_a")

  @@unique([tenantId, embudoId, orden])
  @@index([tenantId, embudoId])
  @@map("etapas")
  @@schema("comercial")
}

/// Oportunidad de venta de una cuenta. El estado se deriva por trigger del tipo de la etapa (R8).
model Negocio {
  id                      String    @id @default(uuid(7)) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  cuentaId                String    @map("cuenta_id") @db.Uuid
  embudoId                String    @map("embudo_id") @db.Uuid
  etapaId                 String    @map("etapa_id") @db.Uuid
  /// "abierto" | "ganado" | "perdido" (derivado por trigger del tipo de la etapa; nadie lo edita).
  estado                  String    @default("abierto")
  titulo                  String
  tipoId                  String?   @map("tipo_id") @db.Uuid
  origenId                String?   @map("origen_id") @db.Uuid
  responsableId           String?   @map("responsable_id") @db.Uuid
  probabilidad            Int       @default(0)
  /// CLP entero. Editable mientras no hay cotización vigente (R12).
  montoEstimadoMensual    Int?      @map("monto_estimado_mensual")
  /// CLP entero. Lo escribe CPQ desde la cotización vigente; solo lectura aquí.
  valorMensual            Int?      @map("valor_mensual")
  cotizacionEnviadaEn     DateTime? @map("cotizacion_enviada_en") @db.Timestamptz(6)
  cierreEstimado          DateTime? @map("cierre_estimado") @db.Date
  inicioServicioEstimado  DateTime? @map("inicio_servicio_estimado") @db.Date
  motivoPerdidaId         String?   @map("motivo_perdida_id") @db.Uuid
  motivoPerdidaDetalle    String?   @map("motivo_perdida_detalle")
  competidor              String?
  ganadoEn                DateTime? @map("ganado_en") @db.Timestamptz(6)
  perdidoEn               DateTime? @map("perdido_en") @db.Timestamptz(6)
  reabiertoEn             DateTime? @map("reabierto_en") @db.Timestamptz(6)
  archivadoEn             DateTime? @map("archivado_en") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  cuenta        Cuenta               @relation(fields: [cuentaId], references: [id])
  embudo        Embudo               @relation(fields: [embudoId], references: [id])
  etapa         Etapa                @relation(fields: [etapaId], references: [id])
  tipo          TipoNegocio?         @relation(fields: [tipoId], references: [id])
  origen        OrigenNegocio?       @relation(fields: [origenId], references: [id])
  motivoPerdida MotivoPerdida?       @relation(fields: [motivoPerdidaId], references: [id])
  instalaciones NegocioInstalacion[]
  contactos     NegocioContacto[]
  historial     HistorialEtapa[]
  solicitudes   Solicitud[]
  actividadVinculos ActividadVinculo[]
  etiquetaAsignaciones EtiquetaAsignacion[]

  @@index([tenantId, estado])
  @@index([tenantId, etapaId])
  @@index([tenantId, cuentaId])
  @@index([tenantId, responsableId])
  @@map("negocios")
  @@schema("comercial")
}

/// Instalación vinculada a un negocio, con su tipo (R7: no copia datos, los lee). Única por par.
model NegocioInstalacion {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  negocioId     String   @map("negocio_id") @db.Uuid
  instalacionId String   @map("instalacion_id") @db.Uuid
  /// "nueva" | "ampliacion" | "renovacion" | "reemplazo"
  tipo          String   @default("nueva")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  negocio     Negocio     @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  instalacion Instalacion @relation(fields: [instalacionId], references: [id])

  @@unique([tenantId, negocioId, instalacionId])
  @@index([tenantId, instalacionId])
  @@map("negocio_instalaciones")
  @@schema("comercial")
}

/// Contacto vinculado a un negocio, con su rol. Único por par; un principal por negocio (R16).
model NegocioContacto {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  negocioId   String   @map("negocio_id") @db.Uuid
  contactoId  String   @map("contacto_id") @db.Uuid
  /// "decisor" | "tecnico" | "compras" | "usuario"
  rol         String   @default("decisor")
  esPrincipal Boolean  @default(false) @map("es_principal")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  negocio  Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  contacto Contacto @relation(fields: [contactoId], references: [id])

  @@unique([tenantId, negocioId, contactoId])
  @@index([tenantId, contactoId])
  @@map("negocio_contactos")
  @@schema("comercial")
}

/// Historial de etapas de un negocio (R11). Append-only (trigger).
model HistorialEtapa {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  negocioId          String   @map("negocio_id") @db.Uuid
  deEtapaId          String?  @map("de_etapa_id") @db.Uuid
  aEtapaId           String   @map("a_etapa_id") @db.Uuid
  /// "system" | "user" | "agent"
  actorTipo          String   @default("user") @map("actor_tipo")
  actorId            String?  @map("actor_id") @db.Uuid
  /// Motivo de la transición (reapertura, pérdida) cuando aplica.
  motivo             String?
  /// Segundos que el negocio estuvo en la etapa anterior.
  segundosEnAnterior Int?     @map("segundos_en_anterior")
  cuando             DateTime @default(now()) @db.Timestamptz(6)

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  deEtapa Etapa?  @relation("historial_de", fields: [deEtapaId], references: [id])
  aEtapa  Etapa   @relation("historial_a", fields: [aEtapaId], references: [id])

  @@index([tenantId, negocioId, cuando])
  @@map("negocio_etapas")
  @@schema("comercial")
}

/// Catálogo por tenant de tipos de negocio (nuevo cliente, ampliación, renovación…).
model TipoNegocio {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  nombre    String
  orden     Int       @default(0)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  negocios Negocio[]

  @@unique([tenantId, nombre])
  @@map("tipos_negocio")
  @@schema("comercial")
}

/// Catálogo por tenant de orígenes de negocio (web, referido, cliente actual…).
model OrigenNegocio {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  nombre    String
  orden     Int       @default(0)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  negocios Negocio[]

  @@unique([tenantId, nombre])
  @@map("origenes_negocio")
  @@schema("comercial")
}

/// Catálogo por tenant de motivos de pérdida (precio, cobertura, plazo…). `exigeDetalle` en "otro".
model MotivoPerdida {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  codigo       String
  nombre       String
  orden        Int       @default(0)
  activo       Boolean   @default(true)
  exigeDetalle Boolean   @default(false) @map("exige_detalle")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  negocios Negocio[]

  @@unique([tenantId, codigo])
  @@map("motivos_perdida")
  @@schema("comercial")
}
