// Maestros del núcleo (Brief 02, ADR-005, ADR-036): cuentas, contactos, instalaciones, puestos,
// personas, vínculos laborales, cargos y estructuras de sueldo en tres niveles. Todo con tenant_id
// y RLS `tenant_isolation`. Dinero en CLP enteros; porcentajes en PCT_ESCALA (@opai/domain).

model Cuenta {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  nombre           String
  razonSocial      String?   @map("razon_social")
  /// RUT canónico "76543210-K" (normalizado en @opai/domain). Único por tenant cuando existe.
  rut              String?
  giro             String?
  /// "prospecto" | "cliente_activo" | "cliente_inactivo"
  estado           String    @default("prospecto")
  origen           String?
  sitioWeb         String?   @map("sitio_web")
  calle            String?
  comuna           String?
  /// Ciudad tributaria (SII); distinta de comuna en muchos casos.
  ciudad           String?
  region           String?
  /// Correo del receptor DTE (datos SII / SimpleAPI); no sustituye contactos con rol facturación.
  emailDte         String?   @map("email_dte")
  pais             String    @default("CL")
  escrituraFecha   DateTime? @map("escritura_fecha") @db.Date
  escrituraNotaria String?   @map("escritura_notaria")
  notas            String?
  clienteDesde     DateTime? @map("cliente_desde") @db.Date
  clienteHasta     DateTime? @map("cliente_hasta") @db.Date
  archivadaEn      DateTime? @map("archivada_en") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  contactos      Contacto[]
  contactoVinculos ContactoCuenta[]
  actividadVinculos ActividadVinculo[]
  etiquetaAsignaciones EtiquetaAsignacion[]
  instalaciones  Instalacion[]
  representantes CuentaRepresentante[]
  /// Consentimientos para usar la cuenta como referencia comercial (CAR-138 PR 7). Append-only.
  referencias    CuentaReferencia[]
  // Relación inversa del módulo Comercial (Brief 07 · PR 1). Virtual: la FK vive en comercial.negocios.
  negocios       Negocio[]

  @@index([tenantId, estado])
  @@index([tenantId, nombre])
  @@map("cuentas")
  @@schema("core")
}

model CuentaRepresentante {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cuentaId  String   @map("cuenta_id") @db.Uuid
  nombre    String
  rut       String
  email     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  cuenta Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([tenantId, cuentaId])
  @@map("cuentas_representantes")
  @@schema("core")
}

/// Consentimiento del cliente para usarlo como referencia en propuestas y documentos (CAR-138 PR 7).
/// Append-only: cada fila es un otorgamiento o una revocación y el estado vigente es la última fila
/// de la cuenta. `opai_app` no tiene UPDATE ni DELETE. Sin fila vigente, la cuenta no aparece.
model CuentaReferencia {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  cuentaId         String    @map("cuenta_id") @db.Uuid
  /// "otorgado" | "revocado" (CHECK en migración).
  estado           String
  /// Si el cliente autorizó mostrar su nombre; si no, se muestra anonimizado (rubro y comuna).
  mostrarNombre    Boolean   @default(false) @map("mostrar_nombre")
  descripcion      String?
  cita             String?
  /// Fecha en que el cliente dio el consentimiento (obligatoria al otorgar).
  otorgadoEn       DateTime? @map("otorgado_en") @db.Date
  vigenteHasta     DateTime? @map("vigente_hasta") @db.Date
  /// Contacto del cliente que lo dio (opcional).
  contactoId       String?   @map("contacto_id") @db.Uuid
  /// "correo" | "documento_firmado" | "contrato" | "acta" | "otro" (obligatoria al otorgar).
  evidencia        String?
  evidenciaDetalle String?   @map("evidencia_detalle")
  /// Motivo de la revocación (obligatorio al revocar).
  motivo           String?
  registradoPorId  String    @map("registrado_por_id") @db.Uuid
  /// Orden real de escritura (identity): la última fila de la cuenta es la de mayor `seq`.
  seq              BigInt    @default(autoincrement())
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  cuenta Cuenta @relation(fields: [cuentaId], references: [id])

  @@index([tenantId, cuentaId, seq])
  @@map("cuentas_referencias")
  @@schema("core")
}

model Contacto {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  cuentaId    String    @map("cuenta_id") @db.Uuid
  nombres     String
  apellidos   String
  email       String?
  /// E.164 ("+56987654321").
  telefono    String?
  cargo       String?
  esPrincipal Boolean   @default(false) @map("es_principal")
  /// "comercial" | "operacional" | "facturacion" | "cobranza"
  roles       String[]  @default([])
  /// "activo" | "inactivo"
  estado      String    @default("activo")
  notas       String?
  archivadoEn DateTime? @map("archivado_en") @db.Timestamptz(6)
  /// Anonimizado por la política de retención o a pedido del titular (Ley 21.719, 07d PR 3).
  anonimizadoEn DateTime? @map("anonimizado_en") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  cuenta Cuenta @relation(fields: [cuentaId], references: [id])
  // Relación inversa del módulo Comercial (Brief 07 · PR 1). Virtual: la FK vive en comercial.negocio_contactos.
  negocioContactos NegocioContacto[]
  // CRM PR 2a (CAR-26): vínculos N–N con cuentas, actividad y etiquetas. FK en core.*.
  cuentaVinculos ContactoCuenta[]
  actividadVinculos ActividadVinculo[]
  etiquetaAsignaciones EtiquetaAsignacion[]

  @@index([tenantId, cuentaId])
  @@map("contactos")
  @@schema("core")
}

model Instalacion {
  actividadVinculos ActividadVinculo[]
  vinculos VinculoLaboral[]
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  cuentaId            String    @map("cuenta_id") @db.Uuid
  nombre              String
  /// "prospecto" | "activa" | "inactiva"
  estado              String    @default("prospecto")
  calle               String?
  comuna              String?
  region              String?
  pais                String    @default("CL")
  direccionFormateada String?   @map("direccion_formateada")
  placeId             String?   @map("place_id")
  lat                 Decimal?  @db.Decimal(10, 7)
  lng                 Decimal?  @db.Decimal(10, 7)
  /// Tolerancia de ubicación en metros (evidencia, nunca bloqueante).
  geocercaM           Int       @default(1000) @map("geocerca_m")
  vigenteDesde        DateTime? @map("vigente_desde") @db.Date
  vigenteHasta        DateTime? @map("vigente_hasta") @db.Date
  notas               String?
  archivadaEn         DateTime? @map("archivada_en") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  cuenta  Cuenta   @relation(fields: [cuentaId], references: [id])
  puestos Puesto[]
  estructuras EstructuraSueldo[]
  /// Supervisores a cargo de esta instalación (alcance por filas, ADR-022 · Brief 07c B3).
  supervisores SupervisorInstalacion[]
  // Relación inversa del módulo Comercial (Brief 07 · PR 1). Virtual: la FK vive en comercial.negocio_instalaciones.
  negocioInstalaciones NegocioInstalacion[]

  @@unique([tenantId, cuentaId, nombre])
  @@index([tenantId, estado])
  @@map("instalaciones")
  @@schema("core")
}

model Cargo {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  nombre         String
  descripcion    String?
  /// "operativo" | "administrativo"
  clase          String   @default("operativo")
  /// Si es true, los montos de sueldo solo los ve quien tiene core:estructuras.read_sensible.
  sueldoSensible Boolean  @default(false) @map("sueldo_sensible")
  activo         Boolean  @default(true)
  orden          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  puestos     Puesto[]
  vinculos    VinculoLaboral[]
  estructuras EstructuraSueldo[]

  @@unique([tenantId, nombre])
  @@map("cargos")
  @@schema("core")
}

/// Puesto de servicio en una instalación (ADR-036, Brief 11 PR 1): 1 puesto = 1 posición cubierta.
/// La dotación se arma con N puestos; la columna `dotacion` queda DEPRECADA (sin borrar). El rol y el
/// ciclo salen del catálogo de patrones (`patronId`) y la función operativa de `funcionId`. El horario
/// va por tramos (día y, si rota, noche), con horas semanales y colación en el puesto, y nace en PPC.
model Puesto {
  vinculos VinculoLaboral[]
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  instalacionId   String    @map("instalacion_id") @db.Uuid
  cargoId         String    @map("cargo_id") @db.Uuid
  /// Función operativa del catálogo del tenant (guardia, supervisor…); null hasta que se elige.
  funcionId       String?   @map("funcion_id") @db.Uuid
  /// Patrón de turno del catálogo del tenant (4×4, 5×2…); null hasta que se elige.
  patronId        String?   @map("patron_id") @db.Uuid
  nombre          String
  diasTrabajo     Int       @map("dias_trabajo")
  diasDescanso    Int       @map("dias_descanso")
  /// "HH:mm". Si horaFin <= horaInicio el turno cruza medianoche.
  horaInicio      String    @map("hora_inicio")
  horaFin         String    @map("hora_fin")
  /// Tramo de noche de la rotación día/noche (opcional), "HH:mm".
  horaInicioNoche String?   @map("hora_inicio_noche")
  horaFinNoche    String?   @map("hora_fin_noche")
  /// "dia" | "noche" | "rotativa"
  jornada         String    @default("dia")
  /// Horas semanales del puesto (sugeridas por el patrón y el horario, editables).
  horasSemanales  Decimal?  @map("horas_semanales") @db.Decimal(5, 2)
  /// Colación en minutos y si va fuera de la jornada (no se descuenta del tiempo trabajado).
  colacionMin     Int       @default(0) @map("colacion_min")
  colacionFuera   Boolean   @default(false) @map("colacion_fuera")
  /// DEPRECADA (Brief 11 PR 1): la dotación se arma con N puestos. Se conserva por compatibilidad.
  dotacion        Int       @default(1)
  /// Cobertura de la posición: "ppc" (sin asignar) | "cubierto". Nace en PPC.
  cobertura       String    @default("ppc")
  /// Motivo del PPC: por ahora solo "sin_asignar" (más motivos en PR 3).
  coberturaMotivo String?   @default("sin_asignar") @map("cobertura_motivo")
  /// "activo" | "inactivo"
  estado          String    @default("activo")
  vigenteDesde    DateTime? @map("vigente_desde") @db.Date
  vigenteHasta    DateTime? @map("vigente_hasta") @db.Date
  notas           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  instalacion Instalacion        @relation(fields: [instalacionId], references: [id])
  cargo       Cargo              @relation(fields: [cargoId], references: [id])
  funcion     FuncionPuesto?     @relation(fields: [funcionId], references: [id])
  patron      PatronTurno?       @relation(fields: [patronId], references: [id])
  estructuras EstructuraSueldo[]

  @@unique([tenantId, instalacionId, nombre])
  @@index([tenantId, patronId])
  @@index([tenantId, funcionId])
  @@map("puestos")
  @@schema("core")
}

model Persona {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  nombres             String
  apellidos           String
  /// RUT canónico, obligatorio y único por tenant.
  rut                 String
  emailPersonal       String?   @map("email_personal")
  emailLaboral        String?   @map("email_laboral")
  telefono            String?
  fechaNacimiento     DateTime? @map("fecha_nacimiento") @db.Date
  /// "femenino" | "masculino" | "otro" | "no_declara"
  sexo                String?
  nacionalidad        String    @default("CL")
  calle               String?
  comuna              String?
  region              String?
  pais                String    @default("CL")
  direccionFormateada String?   @map("direccion_formateada")
  placeId             String?   @map("place_id")
  lat                 Decimal?  @db.Decimal(10, 7)
  lng                 Decimal?  @db.Decimal(10, 7)
  /// "activa" | "inactiva"
  estado              String    @default("activa")
  bloqueada           Boolean   @default(false)
  bloqueoMotivo       String?   @map("bloqueo_motivo")
  bloqueadaEn         DateTime? @map("bloqueada_en") @db.Timestamptz(6)
  /// Usuario de OPAI vinculado (1:1), si la persona entra al sistema.
  usuarioId           String?   @map("usuario_id") @db.Uuid
  archivadaEn         DateTime? @map("archivada_en") @db.Timestamptz(6)
  /// Anonimizada por la política de retención o a pedido del titular (Ley 21.719, 07d PR 3).
  anonimizadaEn       DateTime? @map("anonimizada_en") @db.Timestamptz(6)
  /// Marca P1 "No recontratar" (design-prompt-personas-cargos.md): visible solo con
  /// core:personas.no_recontratar.manage (RRHH/admin). Base de interés legítimo (art. 13 d) de la Ley
  /// 19.628, modificada por la 21.719); el motivo es texto libre (lista cerrada pendiente de Carlos,
  /// ver brief). Vence siempre (noRecontratarVenceEn obligatorio al marcar); al vencer, las 4 columnas
  /// se limpian (core.personas.no_recontratar_vencer).
  noRecontratar        Boolean   @default(false) @map("no_recontratar")
  noRecontratarMotivo  String?   @map("no_recontratar_motivo")
  noRecontratarEn      DateTime? @map("no_recontratar_en") @db.Timestamptz(6)
  noRecontratarVenceEn DateTime? @map("no_recontratar_vence_en") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  vinculos    VinculoLaboral[]
  estructuras EstructuraSueldo[]
  anexos      AnexoContrato[]
  prevision   PersonaPrevision?
  pago        PersonaPago?
  pagoSolicitudes PersonaPagoSolicitud[]
  uniforme    PersonaUniforme?
  uniformeEntregas PersonaUniformeEntrega[]
  jornadaDt   PersonaJornadaDt?
  os10        PersonaOs10?
  contactoLaboral PersonaContactoLaboral?

  @@unique([tenantId, rut])
  @@index([tenantId, estado])
  @@index([tenantId, apellidos])
  @@map("personas")
  @@schema("core")
}

model VinculoLaboral {
  instalacionId String? @map("instalacion_id") @db.Uuid
  puestoId String? @map("puesto_id") @db.Uuid
  horasSemanales Int? @map("horas_semanales")
  distribucion String?
  /// ordinaria | excepcional | parcial | teletrabajo (Asistencia define los descansos de cada tipo)
  tipoJornada String @default("ordinaria") @map("tipo_jornada")
  instalacion Instalacion? @relation(fields: [instalacionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "vinculos_instalacion_fkey")
  puesto Puesto? @relation(fields: [puestoId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "vinculos_puesto_fkey")
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  personaId     String    @map("persona_id") @db.Uuid
  cargoId       String    @map("cargo_id") @db.Uuid
  /// "indefinido" | "plazo_fijo" | "por_obra" | "honorarios"
  tipo          String
  inicio        DateTime  @db.Date
  termino       DateTime? @db.Date
  motivoTermino String?   @map("motivo_termino")
  /// "vigente" | "terminado". Un solo vigente por persona (índice parcial en la migración).
  estado        String    @default("vigente")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  persona Persona @relation(fields: [personaId], references: [id])
  cargo   Cargo   @relation(fields: [cargoId], references: [id])
  anexos  AnexoContrato[]

  @@index([tenantId, personaId])
  @@index([tenantId, instalacionId, estado], map: "vinculos_tenant_instalacion_idx")
  @@map("vinculos_laborales")
  @@schema("core")
}

/// Estructura de sueldo versionada por vigencia (ADR-005): nivel cargo, puesto o persona.
model EstructuraSueldo {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  /// "instalacion" | "puesto" | "persona"; "cargo" solo para históricos.
  nivel              String
  cargoId            String?   @map("cargo_id") @db.Uuid
  puestoId           String?   @map("puesto_id") @db.Uuid
  personaId          String?   @map("persona_id") @db.Uuid
  instalacionId      String?   @map("instalacion_id") @db.Uuid
  /// NULL histórico significa estructura incompleta, nunca herencia entre capas.
  sueldoBase         Int?      @map("sueldo_base")
  colacion           Int?
  movilizacion       Int?
  /// "legal_25" | "monto_fijo" | "ninguna"
  gratificacion      String?
  gratificacionMonto Int?      @map("gratificacion_monto")
  vigenteDesde       DateTime  @map("vigente_desde") @db.Date
  vigenteHasta       DateTime? @map("vigente_hasta") @db.Date
  /// Obligatorio en nivel persona (excepción por RUT).
  motivo             String?
  /// "vigente" | "anulada"
  estado             String    @default("vigente")
  creadoPor          String?   @map("creado_por") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  cargo   Cargo?           @relation(fields: [cargoId], references: [id])
  puesto  Puesto?          @relation(fields: [puestoId], references: [id])
  persona Persona?         @relation(fields: [personaId], references: [id])
  instalacion Instalacion? @relation(fields: [instalacionId], references: [id])
  items   EstructuraItem[]

  @@index([tenantId, nivel, cargoId])
  @@index([tenantId, nivel, puestoId])
  @@index([tenantId, nivel, personaId])
  @@index([tenantId, nivel, instalacionId])
  @@map("estructuras_sueldo")
  @@schema("core")
}

model EstructuraItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  estructuraId String   @map("estructura_id") @db.Uuid
  /// "bono_fijo" | "bono_porcentual"
  tipo         String
  nombre       String
  monto        Int?
  /// En PCT_ESCALA (19% = 190.000).
  porcentaje   Int?
  imponible    Boolean  @default(true)
  tributable   Boolean  @default(true)
  orden        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  estructura EstructuraSueldo @relation(fields: [estructuraId], references: [id], onDelete: Cascade)

  @@index([tenantId, estructuraId])
  @@map("estructuras_items")
  @@schema("core")
}

/// Previsión social de la persona (Personas y Cargos PR 2). Plan ISAPRE cifrado en aplicación.
model PersonaPrevision {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  personaId       String   @unique @map("persona_id") @db.Uuid
  afp             String?
  regimen         String?
  sistemaSalud    String?  @map("sistema_salud")
  isapreNombre    String?  @map("isapre_nombre")
  planIsapre      String?  @map("plan_isapre")
  planUf          Decimal? @map("plan_uf") @db.Decimal(10, 4)
  cotizacionUfPct Decimal? @map("cotizacion_uf_pct") @db.Decimal(10, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([tenantId, personaId])
  @@map("personas_prevision")
  @@schema("core")
}

/// Cuenta bancaria vigente de la persona (número cifrado en aplicación).
model PersonaPago {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  personaId    String   @unique @map("persona_id") @db.Uuid
  bancoCodigo  String?  @map("banco_codigo")
  tipoCuenta   String?  @map("tipo_cuenta")
  numeroCuenta String?  @map("numero_cuenta")
  rutTitular   String?  @map("rut_titular")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([tenantId, personaId])
  @@map("personas_pago")
  @@schema("core")
}

/// Solicitud de cambio de cuenta bancaria (RRHH aprueba o rechaza; una pendiente por persona).
model PersonaPagoSolicitud {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  personaId        String    @map("persona_id") @db.Uuid
  bancoCodigo      String?   @map("banco_codigo")
  tipoCuenta       String?   @map("tipo_cuenta")
  numeroCuenta     String?   @map("numero_cuenta")
  rutTitular       String?   @map("rut_titular")
  /// "pendiente" | "aprobada" | "rechazada"
  estado           String    @default("pendiente")
  solicitadoPorId  String    @map("solicitado_por_id") @db.Uuid
  resueltoPorId    String?   @map("resuelto_por_id") @db.Uuid
  motivoRechazo    String?   @map("motivo_rechazo")
  resueltaEn       DateTime? @map("resuelta_en") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([tenantId, personaId, estado])
  @@map("personas_pago_solicitudes")
  @@schema("core")
}

model PersonaUniforme {
  id           String   @id @default(uuid(7)) @db.Uuid
