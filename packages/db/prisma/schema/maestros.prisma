  personaId    String   @unique @map("persona_id") @db.Uuid
  tallaCamisa  String?  @map("talla_camisa")
  tallaPantalon String? @map("talla_pantalon")
  tallaChaqueta String? @map("talla_chaqueta")
  tallaZapato  String?  @map("talla_zapato")
  notas        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant                  @relation(fields: [tenantId], references: [id])
  persona  Persona                 @relation(fields: [personaId], references: [id], onDelete: Cascade)
  entregas PersonaUniformeEntrega[]

  @@index([tenantId, personaId])
  @@map("personas_uniforme")
