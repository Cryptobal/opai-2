/// Mapeo a ids de otros sistemas (importación desde OPAI 1.0 en la fase 2).
model IdExterno {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  entidadTipo String   @map("entidad_tipo")
  entidadId   String   @map("entidad_id") @db.Uuid
  sistema     String
  idExterno   String   @map("id_externo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sistema, entidadTipo, idExterno])
  @@index([tenantId, entidadTipo, entidadId])
  @@map("ids_externos")
  @@schema("core")
}
