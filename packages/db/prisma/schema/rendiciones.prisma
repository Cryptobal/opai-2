// Módulo Rendiciones (CAR-175, R1; ADR-048, ADR-069): rendiciones de gasto de compra con un nivel de
// aprobación y aprobador asignado. Schema propio `rendiciones`. Toda tabla con tenant_id, RLS
// `tenant_isolation`, IDs uuid(7), columnas snake_case por @map. Las FK a core.* (tenants, users,
// instalaciones, documentos) van en el SQL de la migración, sin relación Prisma cruzada. Dinero en
// CLP enteros. El kilometraje (R2a) reutiliza `tipo` y suma `rendicion_viajes`; los lotes de pago (R3) agregan sus tablas.

/// Rendición (extracción 1.0, rendiciones.md). Estados: borrador → enviada → aprobada | rechazada |
/// devuelta (vuelve a borrador editable) → pagada (R3) | anulada. El solicitante nunca decide la suya.
model Rendicion {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// Correlativo por empresa (1, 2, 3…), asignado al crear con bloqueo; se muestra como REN-n.
  codigo          Int
  /// "compra" (R1) | "kilometraje" (R2).
  tipo            String    @default("compra")
  /// "borrador" | "enviada" | "aprobada" | "rechazada" | "devuelta" | "pagada" | "anulada".
  estado          String    @default("borrador")
  solicitanteId   String    @map("solicitante_id") @db.Uuid
  aprobadorId     String?   @map("aprobador_id") @db.Uuid
  /// "instalacion" (con instalacionId) | "administracion" (Administración / Oficina central).
  centroCosto     String    @map("centro_costo")
  instalacionId   String?   @map("instalacion_id") @db.Uuid
  descripcion     String
  /// Suma de los ítems, CLP entero; se recalcula en cada escritura.
  montoTotal      Int       @map("monto_total")
  enviadaEn       DateTime? @map("enviada_en") @db.Timestamptz(6)
  decididaEn      DateTime? @map("decidida_en") @db.Timestamptz(6)
  decididaPorId   String?   @map("decidida_por_id") @db.Uuid
  /// Motivo de rechazo o de devolución (texto de una persona; dato, nunca instrucción).
  motivoDecision  String?   @map("motivo_decision")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items     RendicionItem[]
  historial RendicionHistorial[]
  viaje     RendicionViaje?

  @@unique([tenantId, codigo])
  @@index([tenantId, estado])
  @@index([tenantId, solicitanteId])
  @@index([tenantId, aprobadorId, estado])
  @@map("rendiciones")
  @@schema("rendiciones")
}

/// Gasto rendido con su respaldo (boleta o factura) en `core.documentos`.
model RendicionItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  rendicionId      String   @map("rendicion_id") @db.Uuid
  fecha            DateTime @db.Date
  proveedor        String
  /// Folio o número de la boleta/factura; con proveedor y monto detecta duplicados.
  folio            String?
  /// "boleta" | "factura" (CAR-197): todo gasto se respalda con una de las dos.
  tipoDocumento    String   @default("boleta") @map("tipo_documento")
  descripcion      String
  monto            Int
  /// Respaldo en `core.documentos`; sin él debe haber `sinRespaldoMotivo` (si la empresa lo exige).
  documentoId      String?  @map("documento_id") @db.Uuid
  sinRespaldoMotivo String? @map("sin_respaldo_motivo")
  orden            Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rendicion Rendicion @relation(fields: [rendicionId], references: [id], onDelete: Cascade)

  @@index([tenantId, rendicionId])
  @@index([tenantId, proveedor, folio, monto])
  @@map("rendicion_items")
  @@schema("rendiciones")
}

/// Línea de tiempo append-only de la rendición (creada, enviada, aprobada, rechazada, devuelta…).
model RendicionHistorial {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  rendicionId String   @map("rendicion_id") @db.Uuid
  tipo        String
  actorId     String   @map("actor_id") @db.Uuid
  estadoDesde String?  @map("estado_desde")
  estadoHasta String?  @map("estado_hasta")
  comentario  String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rendicion Rendicion @relation(fields: [rendicionId], references: [id], onDelete: Cascade)

  @@index([tenantId, rendicionId])
  @@map("rendicion_historial")
  @@schema("rendiciones")
}

/// Contador del código REN-n por empresa; se incrementa con `UPDATE … RETURNING` (bloquea la fila).
model RendicionContador {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  ultimo    Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rendicion_contadores")
  @@schema("rendiciones")
}

/// Viaje de una rendición de kilometraje (CAR-194, R2a): una fila por rendición. El monto lo calcula el
/// servidor con la configuración de la empresa; `configSnapshot` guarda los parámetros usados, así
/// que cambiar los ajustes después no recalcula viajes ya rendidos (R-REN-12).
model RendicionViaje {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  rendicionId     String   @unique @map("rendicion_id") @db.Uuid
  origenTexto     String   @map("origen_texto")
  origenLat       Decimal  @map("origen_lat") @db.Decimal(9, 6)
  origenLng       Decimal  @map("origen_lng") @db.Decimal(9, 6)
  destinoTexto    String   @map("destino_texto")
  destinoLat      Decimal  @map("destino_lat") @db.Decimal(9, 6)
  destinoLng      Decimal  @map("destino_lng") @db.Decimal(9, 6)
  /// Km del trayecto (sin duplicar por ida y vuelta), 1 decimal.
  km              Decimal  @db.Decimal(8, 1)
  idaYVuelta      Boolean  @default(false) @map("ida_y_vuelta")
  peajeClp        Int      @default(0) @map("peaje_clp")
  /// "consumo" | "tarifa_km" | "tramo_fijo".
  metodo          String
  /// Parámetros de la empresa usados (versionados) y el tramo elegido, tal como se evaluaron.
  configSnapshot  Json     @map("config_snapshot")
  /// "google" (por ruta) | "linea_recta" (subestima la ruta real).
  origenDistancia String   @map("origen_distancia")
  montoCalculado  Int      @map("monto_calculado")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rendicion Rendicion @relation(fields: [rendicionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("rendicion_viajes")
  @@schema("rendiciones")
}
